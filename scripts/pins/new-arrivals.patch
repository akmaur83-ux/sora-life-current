diff --git a/src/styles/v2-home.css b/src/styles/v2-home.css
index ad3fbff..3bc4917 100644
--- a/src/styles/v2-home.css
+++ b/src/styles/v2-home.css
@@ -357,4 +357,49 @@
 @media (prefers-reduced-motion: reduce) {
   .hx-hero__track, .hx-tile__image, .hx-store__image, .hx-btn svg, .hx-tile__go, .hx-jewel__image, .hx-jewel__cta svg { transition: none; }
   .hx .hx-btn:hover svg, .hx-tile:hover .hx-tile__go, .hx-tile:hover .hx-tile__image, .hx-store:hover .hx-store__image, .hx-jewel__link:hover .hx-jewel__image, .hx-jewel__link:hover .hx-jewel__cta svg { transform: none; }
+}
+
+/* ---- New Arrivals (NewArrivals.jsx) ----------------------------------------------------
+   The products flagged new, mid-page: the "Explore the stores" heading (.hx-stores__head,
+   .hx-stores__h, .hx-more) with arrows beside "View All", then the fashion category strip's
+   track — whole cards on transform only, --per cards in view. Square edges throughout. A
+   wellness packshot sits whole in its frame (as on the wellness cards); a fashion or Home &
+   Living photograph fills it (as on theirs). */
+/* The section above (the festive promo) brings its own space below it; this adds a little. */
+.hx-new { padding-block: 12px 48px; }
+.hx-new__tools { display: flex; align-items: center; gap: 14px; }
+.hx-new__arrows { display: flex; gap: 8px; }
+.hx-new__arrows button { display: grid; place-items: center; width: 40px; height: 40px; padding: 0; border: 1px solid var(--hx-ink); border-radius: 0; background: transparent; color: var(--hx-ink); cursor: pointer; transition: background-color .2s ease, color .2s ease; }
+.hx-new__arrows button:disabled { opacity: .3; cursor: default; }
+/* clip, not hidden: a clipped box is not a scroll container, so focusing a card that is still sliding in
+   cannot scroll it and leave the row out of step with its arrows (hidden stays for older browsers). */
+.hx-new__viewport { overflow: hidden; overflow: clip; touch-action: pan-y; }
+.hx-new__track { --per: 5; --gap: 20px; display: flex; gap: var(--gap); margin: 0; padding: 0; list-style: none; transform: translateX(calc(var(--i, 0) * -1 * ((100% - (var(--per) - 1) * var(--gap)) / var(--per) + var(--gap)))); transition: transform .5s ease; }
+.hx-new__item { flex: 0 0 calc((100% - (var(--per) - 1) * var(--gap)) / var(--per)); min-width: 0; }
+.hx-new__card { display: grid; gap: 6px; }
+.hx-new__art { display: block; aspect-ratio: 1; margin-bottom: 6px; overflow: hidden; background: var(--hx-soft); }
+.hx-new__image { display: block; width: 100%; height: 100%; object-fit: cover; transition: transform .5s ease; }
+.hx-new__art--whole { background: #fff; }
+.hx-new__art--whole .hx-new__image { object-fit: contain; padding: 8%; }
+.hx-new__name { display: -webkit-box; overflow: hidden; -webkit-box-orient: vertical; -webkit-line-clamp: 2; font: 500 14px/1.35 var(--slv2-sans); color: var(--hx-ink); }
+.hx-new__price { font: 600 15px/1.3 var(--slv2-sans); color: var(--hx-ink); }
+@media (hover: hover) and (pointer: fine) {
+  .hx-new__arrows button:hover:not(:disabled) { background: var(--hx-ink); color: #fff; }
+  .hx-new__card:hover .hx-new__image { transform: scale(1.04); }
+}
+@media (max-width: 1023px) {
+  .hx-new__track { --per: 3; --gap: 16px; }
+}
+@media (max-width: 700px) {
+  .hx-new { padding-block: 14px 28px; }
+  .hx-new__tools { gap: 10px; }
+  .hx-new__arrows { gap: 6px; }
+  .hx-new__arrows button { width: 34px; height: 34px; }
+  .hx-new__track { --per: 2; --gap: 12px; }
+  .hx-new__name { font-size: 13px; }
+  .hx-new__price { font-size: 14px; }
+}
+@media (prefers-reduced-motion: reduce) {
+  .hx-new__track, .hx-new__image, .hx-new__arrows button { transition: none; }
+  .hx-new__card:hover .hx-new__image { transform: none; }
 }
