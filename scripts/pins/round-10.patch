+      if (!seen.has(brand)) { cur.orders += 1; seen.add(brand); }
+      m.set(brand, cur);
+    }
+  }
+  return [...m.values()].sort((a, b) => b.revenue - a.revenue || a.brand.localeCompare(b.brand));
