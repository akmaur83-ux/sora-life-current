+/* Desktop: the buy bar at the foot once the buy box has scrolled away (2026-11-09; SiteAssist sets html.pdp-bar-on). */
+@media (min-width: 900px) {
+  html.pdp-bar-on .fs-pdp__bar { position: fixed; left: 0; right: 0; bottom: 0; z-index: 30; display: flex; justify-content: flex-end; align-items: center; gap: 10px; padding: 10px max(24px, calc((100vw - 1480px) / 2)); background: #fff; border-top: 1px solid #D5D9D9; box-shadow: 0 -6px 18px -12px rgba(15, 17, 17, .3); animation: fs-bar-in .2s ease-out; }
