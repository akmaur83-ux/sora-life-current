+@keyframes fs-bar-in { from { transform: translateY(100%); } to { transform: none; } }
+@media (prefers-reduced-motion: reduce) { html.pdp-bar-on .fs-pdp__bar { animation: none; } }
+/* Size guide (2026-11-09). */
+.fs-sizeguide__open { display: inline-flex; align-items: center; gap: 6px; margin: 2px 0 12px; padding: 0; border: 0; background: none; font: 400 13px Arial, sans-serif; color: #007185; cursor: pointer; }
+.fs-sizeguide__open:hover { color: #C7511F; text-decoration: underline; }
+.fs-sizeguide { position: fixed; inset: 0; z-index: 80; display: grid; place-items: center; padding: 16px; background: rgba(15, 17, 17, .55); }
+.fs-sizeguide__box { width: min(560px, 100%); max-height: calc(100vh - 32px); overflow-y: auto; padding: 18px 20px 20px; background: #fff; font-family: Arial, "Helvetica Neue", Helvetica, sans-serif; color: #0F1111; }
+.fs-sizeguide__top { display: flex; justify-content: space-between; align-items: center; }
+.fs-sizeguide__top h2 { margin: 0; font-size: 20px; font-weight: 700; }
+.fs-sizeguide__x { width: 36px; height: 36px; border: 0; background: none; cursor: pointer; color: #0F1111; }
+.fs-sizeguide__tabs { display: flex; gap: 0; margin: 12px 0; border-bottom: 1px solid #D5D9D9; }
+.fs-sizeguide__tabs button { padding: 8px 16px; border: 0; border-bottom: 2px solid transparent; background: none; font: 600 14px Arial, sans-serif; color: #565959; cursor: pointer; }
+.fs-sizeguide__tabs button.is-on { color: #0F1111; border-bottom-color: #C2500A; }
+.fs-sizeguide__table { width: 100%; border-collapse: collapse; font-size: 14px; }
+.fs-sizeguide__table caption { caption-side: top; text-align: left; padding-bottom: 6px; font-size: 12px; color: #565959; }
+.fs-sizeguide__table th, .fs-sizeguide__table td { padding: 8px 10px; border-bottom: 1px solid #E7E7E7; text-align: left; }
+.fs-sizeguide__table thead th { background: #F7F7F7; font-weight: 700; }
+.fs-sizeguide__table tr.is-sold th, .fs-sizeguide__table tr.is-sold td { background: #FFF4E5; }
+.fs-sizeguide__how { margin: 14px 0 8px; padding-left: 18px; font-size: 13px; line-height: 1.5; }
+.fs-sizeguide__note { margin: 0; font-size: 12px; color: #565959; }
