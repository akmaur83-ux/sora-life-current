diff --git a/src/lib/searchMatch.js b/src/lib/searchMatch.js
index 6f70a66..6b7c31d 100644
--- a/src/lib/searchMatch.js
+++ b/src/lib/searchMatch.js
@@ -25,3 +25,58 @@ export function searchItems(items, query, fields = (x) => [x.name, x.brand, x.ca
