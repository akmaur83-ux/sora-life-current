+.hx-skip:focus { top: 12px; outline: 2px solid #FFD08A; }
+/* Show more on long listings, popular categories in the search box, the Diwali gift shop (2026-11-09). */
+.hx-more-wrap { display: grid; justify-items: center; gap: 10px; margin: 28px auto 8px; max-width: 360px; font-family: Arial, "Helvetica Neue", Helvetica, sans-serif; }
+.hx-more-wrap__n { margin: 0; font-size: 13px; color: #565959; }
+.hx-more-wrap__bar { width: 100%; height: 3px; background: #E7E7E7; }
+.hx-more-wrap__bar i { display: block; height: 100%; background: #C2500A; }
+.hx-more-wrap__btn { min-width: 220px; height: 44px; border: 1px solid #0F1111; background: #fff; color: #0F1111; font: 600 14px Arial, sans-serif; cursor: pointer; }
+.hx-more-wrap__btn:hover { background: #0F1111; color: #fff; }
+.hx-suggest__chips { display: flex; flex-wrap: wrap; gap: 8px; padding: 2px 12px 12px; }
+.hx-suggest__chip { padding: 6px 12px; border: 1px solid #D5D9D9; color: #0F1111; font-size: 13px; text-decoration: none; }
+.hx-suggest__chip:hover { border-color: #C2500A; color: #C2500A; }
+.hx-gifts { padding-block: 28px 32px; font-family: Arial, "Helvetica Neue", Helvetica, sans-serif; }
+.hx-gifts__eyebrow { margin: 0 0 6px; font-size: 11px; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; color: #C2500A; }
+.hx-gifts__h { margin: 0 0 16px; font-family: var(--slv2-disp); font-size: clamp(26px, 3vw, 38px); font-weight: 500; color: #0F1111; }
+.hx-gifts__grid { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 14px; margin: 0; padding: 0; list-style: none; }
+.hx-gifts__tile { display: grid; gap: 8px; color: #0F1111; text-decoration: none; }
+.hx-gifts__img { display: block; aspect-ratio: 1; overflow: hidden; background: #F7F2EA; }
+.hx-gifts__img img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .4s ease; }
+.hx-gifts__tile:hover .hx-gifts__img img { transform: scale(1.04); }
+.hx-gifts__label { display: flex; justify-content: space-between; align-items: center; gap: 6px; font-size: 14px; font-weight: 700; }
+.hx-gifts__tile:hover .hx-gifts__label { color: #C2500A; }
+@media (max-width: 1023px) { .hx-gifts__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
+@media (max-width: 599px) { .hx-gifts__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; } .hx-gifts__label { font-size: 13px; } }
+@media (prefers-reduced-motion: reduce) { .hx-gifts__img img { transition: none; } .hx-gifts__tile:hover .hx-gifts__img img { transform: none; } }
