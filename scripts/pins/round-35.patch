+.fs .sora-winter__ghost { border-radius: 0 !important; }
+/* ============================================================
+   The floating cart bar, round 35 (owner, 2026-11-21: Blinkit/Zepto patterns, SORA's look):
+   a rounded forest pill floating just above the bottom navigation, the last things added
+   as overlapping pictures, the MRP saving in gold, a bump when something lands.
+   ============================================================ */
+@media screen and (max-width: 900px) {
+  .v2-cart-dock--active { pointer-events: none; }
+  .v2-cart-dock--active > * { pointer-events: auto; }
+  .v2-cart-dock--active > .hl-nav { position: static; }
+  .v2-cart-dock--active > .v2-mobile-cart {
+    margin: 0 10px 8px; width: auto; border-radius: 16px; gap: 10px;
+    padding: 8px 10px 8px 12px; box-shadow: 0 10px 26px rgba(20, 38, 28, .28), 0 0 0 1px rgba(255, 255, 255, .06) inset;
+    animation: cb-in .38s cubic-bezier(.2, .9, .3, 1.2) both;
+  }
+  .v2-mobile-cart--bump { animation: cb-bump .45s cubic-bezier(.3, 1.6, .5, 1) both !important; }
+  @keyframes cb-in { from { transform: translateY(24px); opacity: 0; } to { transform: none; opacity: 1; } }
+  @keyframes cb-bump { 0% { transform: scale(1); } 40% { transform: scale(1.04); } 100% { transform: scale(1); } }
+  .v2-mobile-cart__thumbs { display: flex; flex: none; padding-left: 2px; }
+  .v2-mobile-cart__thumbs img {
+    width: 34px; height: 34px; border-radius: 50%; object-fit: cover; background: #fff;
+    border: 2px solid var(--slv2-cta-primary-bg, #1F3A2E); margin-left: -12px; position: relative; z-index: calc(3 - var(--i));
+  }
+  .v2-mobile-cart__thumbs img:first-child { margin-left: 0; }
+  .v2-mobile-cart__totals { flex: 1; flex-wrap: wrap; row-gap: 0; column-gap: 8px; }
+  .v2-mobile-cart__saved { flex-basis: 100%; font-size: 11px; line-height: 14px; font-weight: 600; color: #F2C14E; letter-spacing: .02em; }
+  .v2-mobile-cart__subtotal { font-size: 17px; line-height: 22px; }
+  .v2-mobile-cart__link { padding: 0 12px; min-height: 40px; border-radius: 10px; background: rgba(255, 255, 255, .14); }
+}
+@media (prefers-reduced-motion: reduce) { .v2-cart-dock--active > .v2-mobile-cart, .v2-mobile-cart--bump { animation: none !important; } }
+
+/* The card's − qty + once the product is in the bag (round 35, 2026-11-21). Same footprint as
+   the button it replaces, so the grid never jumps. */
+.v2-pc__step {
+  display: grid; grid-template-columns: 38px 1fr 38px; align-items: center; height: 34px; width: 100%;
+  border-radius: var(--slv2-r-ui); background: var(--slv2-cta-primary-bg); color: var(--slv2-cta-primary-text);
+  font-family: var(--slv2-sans); animation: pc-step .28s cubic-bezier(.3, 1.4, .5, 1) both;
+}
+.v2-pc__step button { height: 100%; display: grid; place-items: center; background: none; border: 0; color: inherit; cursor: pointer; border-radius: var(--slv2-r-ui); }
+.v2-pc__step button:hover:not(:disabled) { background: rgba(255, 255, 255, .12); }
+.v2-pc__step button:disabled { opacity: .45; cursor: not-allowed; }
+.v2-pc__step button:focus-visible { outline: 2px solid #fff; outline-offset: -3px; }
+.v2-pc__step span { text-align: center; font-size: 14px; font-weight: 700; font-variant-numeric: tabular-nums; }
+@keyframes pc-step { from { transform: scale(.92); opacity: .4; } to { transform: none; opacity: 1; } }
+@media (min-width: 768px) { .v2-pc__step { height: 42px; grid-template-columns: 44px 1fr 44px; } }
+@media (prefers-reduced-motion: reduce) { .v2-pc__step { animation: none; } }
+
+/* The cart's savings line and its "Before you checkout" row (round 35, 2026-11-21). */
+.sora-saved {
+  display: flex; align-items: center; gap: 8px; margin: 0 0 14px; padding: 10px 14px; border-radius: 10px;
+  background: #E8F4EC; color: #1E5B3A; font-size: 14px; border: 1px solid #CFE6D7;
+  animation: sv-in .5s cubic-bezier(.2, .9, .3, 1.1) both;
+}
+.sora-saved b { font-weight: 800; }
+@keyframes sv-in { from { opacity: 0; transform: translateY(-6px); } to { opacity: 1; transform: none; } }
+.sora-addons { margin: 22px 0 6px; }
+.sora-addons__h { margin: 0; font-family: var(--slv2-serif, Georgia, serif); font-size: 20px; font-weight: 600; }
+.sora-addons__sub { margin: 2px 0 10px; font-size: 13px; color: #565959; }
+.sora-addons__row {
+  display: grid; grid-auto-flow: column; grid-auto-columns: 132px; gap: 10px; margin: 0; padding: 2px 2px 8px; list-style: none;
+  overflow-x: auto; overscroll-behavior-x: contain; scroll-snap-type: x proximity; scrollbar-width: none;
+}
+.sora-addons__row::-webkit-scrollbar { display: none; }
+.sora-addons__item { display: flex; flex-direction: column; gap: 5px; padding: 8px; border: 1px solid var(--slv2-line, #E6E2D8); border-radius: 12px; background: var(--slv2-paper, #fff); scroll-snap-align: start; }
+.sora-addons__pic { display: block; aspect-ratio: 1; overflow: hidden; border-radius: 8px; }
+.sora-addons__name { font-size: 12px; line-height: 1.3; color: inherit; text-decoration: none; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; min-height: 2.6em; }
+.sora-addons__price { font-size: 13px; font-weight: 700; }
+.sora-addons__price s { margin-left: 5px; font-size: 11px; font-weight: 400; color: #6B6B6B; }
+.sora-addons__add {
+  margin-top: auto; display: inline-flex; align-items: center; justify-content: center; gap: 4px; height: 32px; border-radius: 8px;
+  background: #fff; color: var(--slv2-cta-primary-bg, #1F3A2E); border: 1.5px solid var(--slv2-cta-primary-bg, #1F3A2E);
+  font-size: 12px; font-weight: 700; cursor: pointer; transition: background .15s ease, color .15s ease, transform .1s ease;
+}
+.sora-addons__add:hover { background: var(--slv2-cta-primary-bg, #1F3A2E); color: #fff; }
+.sora-addons__add:active { transform: scale(.95); }
+@media (prefers-reduced-motion: reduce) { .sora-saved { animation: none; } }
+
+/* Checkout: the chosen saved address as one card (round 35, 2026-11-21). */
+.sora-shipto {
+  display: grid; grid-template-columns: auto 1fr auto; gap: 12px; align-items: start; margin: 4px 0 18px; padding: 14px;
+  border: 1.5px solid var(--slv2-cta-primary-bg, #1F3A2E); border-radius: 12px; background: #F4F8F5;
+  animation: sv-in .35s ease both;
+}
+.sora-shipto > svg { margin-top: 2px; color: var(--slv2-cta-primary-bg, #1F3A2E); }
+.sora-shipto__body { display: grid; gap: 2px; font-size: 14px; line-height: 1.4; min-width: 0; }
+.sora-shipto__label { font-size: 11px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: #4F6357; }
+.sora-shipto .linkbtn { font-weight: 700; }
+
+/* The product page skeleton (round 35, 2026-11-21). */
+.sora-skel-pdp { display: grid; gap: 18px; padding: 12px 0 32px; }
+.sora-skel-pdp__img { aspect-ratio: 1; width: 100%; max-width: 560px; border-radius: 4px; }
+.sora-skel-pdp__info { display: grid; gap: 12px; }
+.sora-skel-pdp__title { height: 22px; width: 90%; border-radius: 4px; }
+.sora-skel-pdp__title--2 { width: 60%; }
+.sora-skel-pdp__btn { height: 48px; width: 100%; max-width: 360px; border-radius: 4px; }
+@media (min-width: 900px) { .sora-skel-pdp { grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: 40px; } }
+.hl-skel-row .sora-skel-grid { grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); }
