+}
+
+/* ============================================================
+   Speed (owner, 2026-11-21: "speed slow lag rhi hai"). Measured on a mid phone: the homepage
+   ran at 11 frames a second with the winter band on screen, every frame repainted. Now only
+   transform and opacity animate (the GPU's job), nothing animated sits behind a blur, a filter
+   or a mask, and the decorations that cannot be cheap are still pictures.
+   ============================================================ */
+/* The scalloped hem: drawn in the page's colour on the band's edge, not a mask over the band. */
+.sora-winter::after {
+  content: ''; position: absolute; left: 0; right: 0; bottom: -1px; height: 10px; z-index: 3; pointer-events: none;
+  background: radial-gradient(9px at 50% 100%, var(--color-bg, #FBF8F1) 98%, transparent) 50% 0 / 22px 10px repeat-x;
+}
+.fs .sora-winter::after { background-image: radial-gradient(9px at 50% 100%, #fff 98%, transparent); }
+/* No blur behind the tiles (it was recomputed every frame with the snow moving behind). */
+.sora-winter__hero, .sora-winter__tile { -webkit-backdrop-filter: none; backdrop-filter: none; background: rgba(255, 255, 255, .1); }
+/* Snowflakes: soft by their own gradient, not a blur filter. */
+.sora-winter__snow i { filter: none !important; background: radial-gradient(circle, #fff 0 45%, rgba(255, 255, 255, .5) 60%, transparent 72%); will-change: transform; }
+.sora-winter__snow--near i { opacity: .55; }
+/* The heading's layers. */
+.sora-winter__title { position: relative; }
+.sora-winter__words { position: relative; z-index: 1; display: block; width: 100%; height: auto; overflow: visible; }
+.sora-muffler { position: absolute; inset: 0; pointer-events: none; }
+.sora-muffler--under { z-index: 0; }
+.sora-muffler--over { z-index: 2; -webkit-mask-image: repeating-linear-gradient(90deg, #000 0 12.5%, transparent 12.5% 25%); mask-image: repeating-linear-gradient(90deg, #000 0 12.5%, transparent 12.5% 25%); }
+.sora-muffler__slide { position: absolute; inset: 0; display: block; will-change: transform; animation: sw-slide2 7s cubic-bezier(.45, 0, .25, 1) infinite; }
+.sora-muffler__slide svg { display: block; width: 100%; height: auto; overflow: visible; }
+.sora-muffler__stripe, .sora-muffler__knit { animation: none; }
+.sora-winter__letters { animation: none; }
+@keyframes sw-slide2 {
+  0% { transform: translate3d(-118%, 0, 0); }
+  22% { transform: translate3d(0, 0, 0); }
+  36% { transform: translate3d(1.4%, -1px, 0); }
+  51% { transform: translate3d(-1.2%, 1px, 0); }
+  66% { transform: translate3d(1%, 0, 0); }
+  80% { transform: translate3d(0, 0, 0); }
+  100% { transform: translate3d(118%, 0, 0); }
+}
+/* Wind: streaks sliding across. */
+.sora-winter__wind { position: absolute; inset: 0; pointer-events: none; z-index: 0; overflow: hidden; }
+.sora-winter__wind span { position: absolute; left: 0; top: var(--top); width: 120px; opacity: 0; will-change: transform, opacity; animation: sw-gust2 var(--d) ease-in-out var(--delay) infinite; }
+.sora-winter__wind svg { display: block; }
+.sora-winter__wind path { fill: none; stroke: rgba(255, 255, 255, .45); stroke-width: 1.5; stroke-linecap: round; }
+@keyframes sw-gust2 { 0% { transform: translate3d(-130px, 0, 0); opacity: 0; } 15% { opacity: .9; } 75% { opacity: .7; } 100% { transform: translate3d(110vw, -14px, 0); opacity: 0; } }
+/* The header's and the chips' snow: still dots (an animated background repainted the sticky header every frame). */
+html.sora-wintertop .v2-hdr::after, html.sora-wintertop .sora-stickycats::after { animation: none; }
+/* The bottom bar: no blur behind it (it is all but opaque), its snow a still pattern. */
+.tabbar.tabbar--winter { animation: none; -webkit-backdrop-filter: none; backdrop-filter: none; }
+@media (prefers-reduced-motion: reduce) { .sora-muffler__slide, .sora-winter__wind span { animation: none !important; transform: none; } .sora-winter__wind { display: none; } }
+/* The old gust drawing animated its stroke (a repaint every frame): the streaks only slide now. */
+.sora-winter__wind path { animation: none !important; stroke-dasharray: none; }
+/* Asleep off screen: nothing in the band runs. */
+.sora-winter.is-asleep *, .sora-winter.is-asleep *::before, .sora-winter.is-asleep *::after { animation-play-state: paused !important; }
+/* The pom-pom hem: still (24 bobbing balls cost more than they gave). */
+.sora-winter__hem i { animation: none; }/* The newsletter card's drifting ring and floating picture: still (2026-11-21, speed). On their
+   own they took a phone from 60 to 41 frames a second, even with the card off screen. */
+.v2-home .nl__card::before, .v2-home .nl__deco { animation: none !important; }
+
+/* Bug audit 2026-11-21: link buttons that inherited dark or grey text on their dark green.
+   The empty checkout's "Browse products" read at 1.3:1, Home & Living's "Back to Home & Living"
+   and "Search for …" on a missing product at 2.3:1. */
+.state a.btn, .state a.btn:hover, .state a.btn:focus-visible { color: var(--btn-fg, #fff); }
+.hl a.hl-btn, .hl a.hl-btn:hover { color: var(--slv2-ivory, #FBF8F1); }
+
+/* Grocery category page (bug audit, 2026-11-21). */
+.gs-cat { padding-top: 8px; }
+.gs-cat__crumbs { display: flex; gap: 6px; align-items: center; margin: 4px 0 10px; font-size: 13px; color: #565959; }
+.gs-cat__crumbs a { color: inherit; }
+.gs-catgrid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
+@media (min-width: 760px) { .gs-catgrid { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 18px; } }
+.gs-cat__empty { display: grid; justify-items: start; gap: 12px; text-align: left; }
+.gs-cat__empty p { margin: 0; }
