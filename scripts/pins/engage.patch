diff --git a/src/styles/v2-pdp.css b/src/styles/v2-pdp.css
index b91e472..3e4dde8 100644
--- a/src/styles/v2-pdp.css
+++ b/src/styles/v2-pdp.css
@@ -1491,3 +1491,30 @@ body:has(.v2-pdp-root .buybar) .page-main {
 .pdpk-eta svg { flex: none; margin-top: 2px; color: #007185; }
 .pdpk-eta b { font-weight: 700; }
 .pdpk-eta em { display: block; font-style: normal; font-size: 12px; color: #565959; }
+/* Customer questions & answers, and "Notify me" when out of stock (2026-11-08). */
+.pdpk-qa { margin-top: 28px; padding-top: 22px; border-top: 1px solid #E7E7E7; font-family: Arial, "Helvetica Neue", Helvetica, sans-serif; color: #0F1111; }
+.pdpk-qa__search { display: flex; align-items: center; gap: 8px; max-width: 520px; margin: 0 0 14px; padding: 0 10px; border: 1px solid #888C8C; background: #fff; }
+.pdpk-qa__search input { flex: 1; min-width: 0; height: 36px; border: 0; outline: 0; font: inherit; font-size: 14px; background: transparent; }
+.pdpk-qa__search:focus-within { border-color: #007185; box-shadow: 0 0 0 3px rgba(0, 113, 133, .18); }
+.pdpk-qa__empty { margin: 0 0 12px; font-size: 14px; color: #565959; }
+.pdpk-qa__list { display: grid; gap: 14px; margin: 0 0 16px; }
+.pdpk-qa__item dt { margin: 0 0 4px; font-size: 14px; font-weight: 700; }
+.pdpk-qa__item dd { margin: 0; font-size: 14px; line-height: 1.5; }
+.pdpk-qa__item span { display: inline-block; min-width: 72px; font-weight: 700; }
+.pdpk-qa__item dd span { font-weight: 400; color: #565959; }
+.pdpk-qa__item em { display: block; margin: 2px 0 0 72px; font-style: normal; font-size: 12px; color: #565959; }
+.pdpk-qa__ask { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 14px; font-size: 14px; }
+.pdpk-qa__ask p { margin: 0; font-weight: 700; }
+.pdpk-qa__ask .pdpk-rev__btn { width: auto; padding: 0 18px; }
+.pdpk-qa__form { max-width: 560px; margin-top: 12px; }
+.pdpk-notify { margin: 6px 0 12px; padding: 12px; border: 1px solid #D5D9D9; background: #F7FAFA; font-family: Arial, "Helvetica Neue", Helvetica, sans-serif; color: #0F1111; }
+.pdpk-notify p { margin: 0; }
+.pdpk-notify__h { display: flex; align-items: center; gap: 6px; font-size: 15px; font-weight: 700; color: #B12704; }
+.pdpk-notify__t { margin: 4px 0 8px !important; font-size: 13px; color: #565959; }
+.pdpk-notify__row { display: flex; gap: 6px; }
+.pdpk-notify__row input { flex: 1; min-width: 0; height: 36px; padding: 0 10px; border: 1px solid #888C8C; font: 14px Arial, sans-serif; background: #fff; }
+.pdpk-notify__row input:focus { outline: 0; border-color: #007185; box-shadow: 0 0 0 3px rgba(0, 113, 133, .18); }
+.pdpk-notify__row button { flex: none; height: 36px; padding: 0 14px; border: 1px solid #C2500A; background: #C2500A; color: #fff; font: 600 13px Arial, sans-serif; cursor: pointer; }
+.pdpk-notify__row button:disabled { opacity: .6; }
+.pdpk-notify__ok { margin-top: 6px !important; font-size: 13px; color: #007600; }
+.pdpk-notify__bad { margin-top: 6px !important; font-size: 13px; color: #B12704; }
