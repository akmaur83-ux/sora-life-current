+.crp.crp--studio .cs-brand__mark .sora-mark { height: 44px; }
+/* About the maker (round 9, 2026-11-16): a partner brand's story on its product pages. */
+.sora-maker { display: grid; grid-template-columns: 120px minmax(0, 1fr); gap: 20px; align-items: center; margin: 28px 0; padding: 20px; background: #FBF8F1; border: 1px solid rgba(30, 58, 47, .12); }
+.sora-maker__img { width: 120px; height: 120px; object-fit: cover; object-position: top; display: block; background: #fff; }
+.sora-maker__eyebrow { margin: 0 0 4px; font-size: 11px; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; color: #8A5A12; }
+.sora-maker__h { margin: 0 0 6px; font-size: 22px; font-weight: 500; color: #1E3A2F; }
+.sora-maker__story { margin: 0 0 10px; font-size: 14px; line-height: 1.55; color: #3d4a43; }
+.sora-maker__cta { display: inline-flex; align-items: center; gap: 6px; font-size: 14px; font-weight: 600; color: #2C5341; text-decoration: none; }
+.sora-maker__cta:hover { text-decoration: underline; }
+@media (max-width: 600px) {
+  .sora-maker { grid-template-columns: 84px minmax(0, 1fr); gap: 14px; padding: 16px; }
+  .sora-maker__img { width: 84px; height: 84px; }
+  .sora-maker__h { font-size: 19px; }
+}
+/* Sizes in stock on the fashion cards (round 9, 2026-11-16). */
+.fs-sizes { margin: 6px 0 0; display: flex; flex-wrap: wrap; gap: 4px; }
+.fs-sizes span { min-width: 24px; padding: 2px 5px; font-size: 11px; line-height: 1.3; text-align: center; color: #3d4a43; border: 1px solid rgba(30, 58, 47, .18); background: #fff; }
+/* Gift receipt (round 9, 2026-11-16): the order's list, no prices. */
+.sora-gift__compose { display: grid; gap: 6px; max-width: 760px; margin: 0 auto 16px; }
+.sora-gift__compose label { font-size: 13px; font-weight: 600; color: #1E3A2F; }
+.sora-gift__compose textarea { width: 100%; padding: 10px 12px; font: inherit; font-size: 15px; border: 1px solid rgba(30, 58, 47, .25); background: #fff; resize: vertical; }
+.sora-gift { max-width: 760px; }
+.sora-gift__head { display: grid; justify-items: center; gap: 8px; text-align: center; padding-bottom: 18px; border-bottom: 1px solid rgba(30, 58, 47, .12); }
+.sora-gift__title { margin: 6px 0 0; font-size: 34px; font-weight: 500; color: #1E3A2F; }
+.sora-gift__note { margin: 22px auto 0; max-width: 560px; padding: 16px 20px; font-family: var(--font-display, Georgia, serif); font-size: 18px; font-style: italic; line-height: 1.5; text-align: center; color: #1E3A2F; background: #FBF8F1; white-space: pre-line; }
+.sora-gift__list { list-style: none; margin: 22px 0; padding: 0; }
+.sora-gift__list li { display: flex; justify-content: space-between; gap: 16px; padding: 12px 0; border-bottom: 1px solid rgba(30, 58, 47, .1); }
+.sora-gift__list strong { display: block; font-weight: 600; color: #1E3A2F; }
+.sora-gift__list em { display: block; font-style: normal; font-size: 13px; color: #5c6a62; }
+/* Shop by ingredient (round 9, 2026-11-16). */
+.sora-ingr__list { list-style: none; margin: 14px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 10px; }
+.sora-ingr__list a { display: inline-flex; align-items: center; gap: 8px; min-height: 40px; padding: 8px 16px; font-size: 14px; font-weight: 600; color: #1E3A2F; text-decoration: none; background: #FBF8F1; border: 1px solid rgba(30, 58, 47, .16); }
+.sora-ingr__list a:hover { border-color: #2C5341; background: #fff; }
+.sora-ingr__list span { font-size: 12px; font-weight: 500; color: #5c6a62; }
