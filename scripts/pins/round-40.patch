+  0% { opacity: 1; transform: rotate(var(--a)) translateY(0) scale(1); }
+  100% { opacity: 0; transform: rotate(var(--a)) translateY(calc(-1 * var(--d))) scale(.4); }
+}
+
+/* ---- Small screens ---- */
+@media (max-width: 1019px) {
+  .crp.crp--studio .cg-row, .crp.crp--studio .cg-yatra__wrap { grid-template-columns: minmax(0, 1fr); }
+}
+@media (max-width: 640px) {
+  .crp.crp--studio .cg-stats { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
+  .crp.crp--studio .cg-stat { padding: 12px; grid-template-columns: 30px minmax(0, 1fr); column-gap: 10px; }
+  .crp.crp--studio .cg-stat__ic { width: 30px; height: 30px; }
+  .crp.crp--studio .cg-stat__v { font-size: 19px; }
+  .crp.crp--studio .cg-badges__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
+  .crp.crp--studio .cg-card { max-width: none; }
+  .crp.crp--studio .cg-card__big { font-size: 64px; }
+  .crp .cc-pill__go { display: none; }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .crp.crp--studio .cg-tile.is-lit, .crp.crp--studio .cg-hamper__box, .crp .cc-pill, .crp .cc-pill__coin,
+  .crp .cc-layer, .crp .cc-card, .crp .cc-card__coin { animation: none; }
+  .crp.crp--studio .cg-btn { transition: none; }
+}
+@media (max-width: 640px) {
+  .crp.crp--studio .cg-stat__l em { display: none; }
+  .crp .cc-pill > span:nth-child(2) { white-space: nowrap; }
+}
