+}
+/* Promotion (2026-11-10): the offers page, the offer banner's share line, the promo / welcome card. */
+.hx-offer__acts { flex-basis: 100%; display: flex; flex-wrap: wrap; align-items: center; gap: 8px 18px; margin: 0; font-size: 13px; }
+.hx-offer__go, .hx-offer__share { display: inline-flex; align-items: center; gap: 5px; color: #FFD08A; font-weight: 700; text-decoration: none; }
+.hx-offer__go:hover, .hx-offer__share:hover { text-decoration: underline; }
+.hx-offers { padding-bottom: 40px; }
+.hx-offers__crumbs { display: flex; align-items: center; gap: 6px; padding-top: 18px; font: 13px Arial, sans-serif; color: #565959; }
+.hx-offers__crumbs a { color: #565959; text-decoration: none; }
+.hx-offers__h { margin: 10px 0 4px; font-family: var(--slv2-serif, Georgia, serif); font-size: clamp(28px, 4vw, 42px); font-weight: 500; color: #1D1D1B; }
+.hx-offers__lede { margin: 0; font: 15px/1.5 Arial, sans-serif; color: #565959; }
+.hx-offers__share { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin: 0 0 18px; font: 14px Arial, sans-serif; color: #0F1111; }
+.hx-offers__btn { display: inline-flex; align-items: center; gap: 6px; height: 36px; padding: 0 14px; border: 1px solid #D5D9D9; background: #fff; color: #0F1111; font: 600 13.5px Arial, sans-serif; text-decoration: none; cursor: pointer; }
+.hx-offers__btn:hover { border-color: #0F1111; }
+.hx-offers__btn--wa { border-color: #1E7A46; background: #1E7A46; color: #fff; }
+.hx-offers__btn--wa:hover { background: #17633a; border-color: #17633a; }
+.hx-offers__tabs { display: flex; gap: 0; margin: 0 0 20px; border-bottom: 1px solid #E7E7E7; overflow-x: auto; scrollbar-width: none; }
+.hx-offers__tab { flex: none; display: inline-flex; align-items: center; gap: 6px; padding: 12px 16px; border: 0; border-bottom: 3px solid transparent; background: none; color: #565959; font: 600 14.5px Arial, sans-serif; cursor: pointer; }
+.hx-offers__tab em { font-style: normal; font-weight: 400; font-size: 12.5px; color: #8A8A8A; }
+.hx-offers__tab.is-on { color: #0F1111; border-bottom-color: #C2500A; }
+.hx-offers__grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(190px, 1fr)); gap: 24px 18px; margin: 0; padding: 0; list-style: none; }
+.hx-offers__save { font: 700 12.5px Arial, sans-serif; color: #067D62; }
+.hx-offers__empty { padding: 40px 0; text-align: center; font: 15px Arial, sans-serif; color: #565959; }
+.hx-pcard { position: fixed; left: 16px; bottom: calc(var(--pcard-foot, 0px) + 16px); z-index: 60; display: grid; grid-template-columns: auto minmax(0, 1fr) auto; gap: 12px; align-items: start; width: min(360px, calc(100vw - 100px)); padding: 14px 12px 14px 14px; background: #fff; border: 1px solid #D5D9D9; border-top: 3px solid #C2500A; box-shadow: 0 14px 34px rgba(15, 17, 17, .22); font-family: Arial, "Helvetica Neue", Helvetica, sans-serif; color: #0F1111; }
+.hx-pcard__ic { display: grid; place-items: center; width: 36px; height: 36px; background: #FFF1E6; color: #C2500A; }
+.hx-pcard__body { min-width: 0; }
+.hx-pcard__t { margin: 0 0 6px; font-size: 14px; font-weight: 700; line-height: 1.3; }
+.hx-pcard__code { display: flex; align-items: center; gap: 8px; margin: 0 0 6px; }
+.hx-pcard__code b { padding: 4px 10px; border: 1px dashed #C2500A; background: #FFF8F2; color: #C2500A; font-size: 15px; letter-spacing: .08em; }
+.hx-pcard__code button { height: 30px; padding: 0 12px; border: 1px solid #0F1111; background: #0F1111; color: #fff; font: 700 12.5px Arial, sans-serif; cursor: pointer; }
+.hx-pcard__s { margin: 0; font-size: 12.5px; line-height: 1.4; color: #565959; }
+.hx-pcard__s a { color: #007185; font-weight: 700; }
+.hx-pcard__x { display: grid; place-items: center; width: 28px; height: 28px; padding: 0; border: 0; background: none; color: #565959; cursor: pointer; }
+.hx-pcard__x:hover { color: #0F1111; background: #F3F3F3; }
+@media (max-width: 599px) {
+  .hx-offers__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px 12px; }
+  .hx-pcard { left: 10px; width: calc(100vw - 88px); padding: 12px 8px 12px 12px; gap: 10px; }
