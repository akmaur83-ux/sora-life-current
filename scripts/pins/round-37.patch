diff --git a/src/styles/sora-ds.css b/src/styles/sora-ds.css
index ad80e51..c6e3a49 100644
--- a/src/styles/sora-ds.css
+++ b/src/styles/sora-ds.css
@@ -1074,3 +1074,111 @@ html.sora-wintertop .sora-winter {
 }
 /* Away from the homepage (the Fashion home) the band darkens the same way, from a lighter top. */
 .sora-winter { background: linear-gradient(180deg, #3B70B8 0%, #2A579C 25%, #1B3F7C 60%, #0E2247 100%); }
+
+/* ============================================================
+   Motion (owner, 2026-11-21: "animations add kro … sab add kro"). lib/motion.js and
+   components/Motion.jsx drive the moving parts; these are their looks. Transform and
+   opacity only; all still under reduced motion; all visible in print.
+   ============================================================ */
+/* 1, 2, 4 · reveal on scroll (the classes exist only while motion.js is revealing). */
+.rv { opacity: 0; transform: translate3d(0, 22px, 0); }
+.rv.rv-in { opacity: 1; transform: none; transition: opacity .55s ease var(--rv-d, 0ms), transform .65s cubic-bezier(.2, .8, .2, 1) var(--rv-d, 0ms); }
+@media print { .rv { opacity: 1 !important; transform: none !important; } }
+
+/* 3 · the header settles when the page scrolls: a shadow, the sparrow a touch smaller. */
+header .logo img, header .logo__img, header [class*="__brand"] img { transition: transform .28s cubic-bezier(.2, .8, .2, 1); transform-origin: left center; }
+html.is-scrolled header .logo img, html.is-scrolled header .logo__img, html.is-scrolled header [class*="__brand"] img { transform: scale(.88); }
+.v2-hdr, .fs-hdr, .hl-hdr { transition: box-shadow .25s ease; }
+html.is-scrolled .v2-hdr, html.is-scrolled .fs-hdr, html.is-scrolled .hl-hdr { box-shadow: 0 6px 18px rgba(16, 32, 60, .14); }
+
+/* 5 · a press you can feel on every main control. */
+.btn:active:not(:disabled), .fs-btn:active:not(:disabled), .hl-btn:active:not(:disabled), .hx-btn:active, .hx-more:active,
+.v2-pc__cta:active:not(:disabled), .sora-addons__add:active, .v2-mobile-cart__link:active, .fs-chip:active, .sora-stickycats a:active,
+.tabbar__item:active, .sora-bc__card:active, .hx-offer__go:active, .linkbtn:active { transform: scale(.96); }
+
+/* 7 · the ripple from the finger. */
+.sora-ripple { position: absolute; inset: 0; overflow: hidden; border-radius: inherit; pointer-events: none; }
+.sora-ripple i { position: absolute; border-radius: 50%; background: currentColor; opacity: .22; transform: scale(0); animation: sora-ripple .6s cubic-bezier(.2, .8, .2, 1) forwards; }
+@keyframes sora-ripple { to { transform: scale(1); opacity: 0; } }
+
+/* 6 · the heart's little burst. */
+.sora-heartbit { position: fixed; z-index: 9999; color: #E0245E; font-size: 12px; line-height: 1; pointer-events: none; }
+
+/* 8 · a chosen chip or filter pops into place. */
+.fs-chip.is-on, .sora-stickycats a.is-on, .v2-fd [aria-pressed="true"], .hl-filters [aria-pressed="true"], .fs-filters [aria-pressed="true"] { animation: chip-on .34s cubic-bezier(.3, 1.5, .5, 1); }
+@keyframes chip-on { 0% { transform: scale(.92); } 60% { transform: scale(1.05); } 100% { transform: none; } }
+
+/* 11 · sheets rise with a little spring (and close by dragging down: motion.js). */
+@media (max-width: 899px) {
+  .fs-sheet__panel { animation: sheet-up .44s cubic-bezier(.25, 1.25, .5, 1) both; }
+  .v2-fd__panel { transition-timing-function: cubic-bezier(.25, 1.2, .5, 1) !important; }
+}
+@keyframes sheet-up { from { transform: translate3d(0, 100%, 0); } to { transform: none; } }
+
+/* 13 · winter snow over the order confirmation (and 20 · the pull-down flurry). */
+.sora-flurry { position: fixed; left: 0; right: 0; top: 0; height: 100vh; pointer-events: none; z-index: 9998; overflow: hidden; }
+.sora-flurry i { position: absolute; top: -14px; width: var(--s); height: var(--s); border-radius: 50%; background: radial-gradient(circle, #fff 0 45%, rgba(255, 255, 255, .6) 60%, transparent 72%); box-shadow: 0 0 2px rgba(30, 60, 110, .35); animation: flurry var(--d) cubic-bezier(.3, .1, .6, 1) var(--delay) forwards; }
+@keyframes flurry { to { transform: translate3d(var(--x), 105vh, 0) rotate(180deg); opacity: .25; } }
+
+/* 14 · a coupon going on: the ticket stamps in and glows once. */
+.cartcoupon__applied { animation: coupon-in .6s cubic-bezier(.3, 1.45, .5, 1) both; }
+@keyframes coupon-in { 0% { transform: scale(.85) rotate(-2deg); opacity: 0; } 60% { transform: scale(1.03) rotate(.5deg); opacity: 1; } 100% { transform: none; } }
+.cartcoupon__appliedcode { animation: coupon-glow 1.4s ease .35s 1; }
+@keyframes coupon-glow { 0%, 100% { text-shadow: none; } 40% { text-shadow: 0 0 10px rgba(242, 193, 78, .9); } }
+
+/* 16 · the homepage hero's words arrive one after another on each slide. */
+.hx-hero__slide[aria-hidden="false"] .hx-eyebrow, .hx-hero__slide[aria-hidden="false"] .hx-hero__title > span, .hx-hero__slide[aria-hidden="false"] .hx-btn { animation: hero-in .75s cubic-bezier(.2, .8, .2, 1) both; }
+.hx-hero__slide[aria-hidden="false"] .hx-hero__title > span { display: inline-block; animation-delay: .1s; }
+.hx-hero__slide[aria-hidden="false"] .hx-hero__title > span + span { animation-delay: .22s; }
+.hx-hero__slide[aria-hidden="false"] .hx-btn { animation-delay: .34s; }
+@keyframes hero-in { from { opacity: .25; transform: translate3d(0, 14px, 0); } to { opacity: 1; transform: none; } }
+
+/* 17 · the offer clock's numbers flip as they change. */
+.hx-offer__clock { perspective: 400px; }
+.hx-offer__clock b { display: inline-block; animation: flip-in .45s cubic-bezier(.3, 1.3, .5, 1) both; transform-origin: 50% 0; backface-visibility: hidden; }
+@keyframes flip-in { from { transform: rotateX(-90deg); opacity: .4; } to { transform: none; opacity: 1; } }
+
+/* 18 · search: a warm ring when the box is in use; suggestions arrive one after another. */
+.v2-hdr__searchbox, .fs-search, .hl-search { transition: box-shadow .2s ease; }
+.v2-hdr__searchbox:focus-within, .fs-search:focus-within, .hl-search:focus-within { box-shadow: 0 0 0 3px rgba(242, 193, 78, .45); }
+.v2-hdr__suggest-item, [role="listbox"] > [role="option"] { animation: sug-in .32s cubic-bezier(.2, .8, .2, 1) both; }
+.v2-hdr__suggest-item:nth-child(2), [role="listbox"] > [role="option"]:nth-child(2) { animation-delay: .04s; }
+.v2-hdr__suggest-item:nth-child(3), [role="listbox"] > [role="option"]:nth-child(3) { animation-delay: .08s; }
+.v2-hdr__suggest-item:nth-child(4), [role="listbox"] > [role="option"]:nth-child(4) { animation-delay: .12s; }
+.v2-hdr__suggest-item:nth-child(5), [role="listbox"] > [role="option"]:nth-child(5) { animation-delay: .16s; }
+.v2-hdr__suggest-item:nth-child(n+6), [role="listbox"] > [role="option"]:nth-child(n+6) { animation-delay: .2s; }
+@keyframes sug-in { from { opacity: 0; transform: translate3d(0, 6px, 0); } to { opacity: 1; transform: none; } }
+.search-overlay > * { animation: sug-in .3s cubic-bezier(.2, .8, .2, 1) both; }
+
+/* 10 · the card's picture growing into the product page's (View Transitions; Chrome). */
+.fs-gallery__slide.is-on img, .hl-gallery__slide.is-on img, .pdp__zoom-trigger img { view-transition-name: sora-hero; }
+::view-transition-group(sora-hero) { animation-duration: .42s; animation-timing-function: cubic-bezier(.2, .8, .2, 1); }
+::view-transition-old(root), ::view-transition-new(root) { animation-duration: .25s; }
+
+@media (prefers-reduced-motion: reduce) {
+  .rv { opacity: 1 !important; transform: none !important; }
+  .fs-chip.is-on, .sora-stickycats a.is-on, .v2-fd [aria-pressed="true"], .hl-filters [aria-pressed="true"], .fs-sheet__panel, .cartcoupon__applied, .cartcoupon__appliedcode,
+  .hx-hero__slide .hx-eyebrow, .hx-hero__slide .hx-hero__title > span, .hx-hero__slide .hx-btn, .hx-offer__clock b, .v2-hdr__suggest-item, [role="listbox"] > [role="option"], .search-overlay > * { animation: none !important; }
+  html.is-scrolled header .logo img, html.is-scrolled header .logo__img, html.is-scrolled header [class*="__brand"] img { transform: none; }
+  .sora-ripple, .sora-flurry, .sora-heartbit { display: none !important; }
+}
+
+/* 19 · the empty-state art. */
+.sora-empty { display: inline-grid; place-items: center; width: 120px; height: 110px; margin: 0 auto 6px; }
+.sora-empty svg { overflow: visible; }
+.sora-empty__string { stroke: #B8B2A3; stroke-width: 1.5; }
+.sora-empty__swing { transform-box: view-box; transform-origin: 60px 14px; animation: empty-swing 3.2s ease-in-out infinite; }
+@keyframes empty-swing { 0%, 100% { transform: rotate(-6deg); } 50% { transform: rotate(6deg); } }
+.sora-empty__shape { fill: #F3EEE3; stroke: var(--slv2-cta-primary-bg, #1F3A2E); stroke-width: 2.5; stroke-linejoin: round; }
+.sora-empty__handle { fill: none; stroke: var(--slv2-cta-primary-bg, #1F3A2E); stroke-width: 2.5; stroke-linecap: round; }
+.sora-empty__rim { stroke: #C4A671; stroke-width: 3; }
+.sora-empty__snow circle { fill: #9FB6D9; opacity: .7; animation: empty-snow 3.2s linear infinite; }
+@keyframes empty-snow { from { transform: translate3d(0, 0, 0); opacity: 0; } 15% { opacity: .75; } to { transform: translate3d(6px, 120px, 0); opacity: 0; } }
+@media (prefers-reduced-motion: reduce) { .sora-empty__swing, .sora-empty__snow circle { animation: none; } .sora-empty__snow { display: none; } }
+
+/* 12 · amounts roll like an odometer when they change (RollNumber.jsx). */
+.roll { display: inline-flex; overflow: hidden; vertical-align: bottom; line-height: inherit; }
+.roll > span { display: inline-block; white-space: pre; }
+.roll > .roll__d { animation: roll-in .42s cubic-bezier(.3, 1.3, .5, 1) both; }
+@keyframes roll-in { from { transform: translate3d(0, 85%, 0); opacity: 0; } to { transform: none; opacity: 1; } }
+@media (prefers-reduced-motion: reduce) { .roll > .roll__d { animation: none !important; } }
