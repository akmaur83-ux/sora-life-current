diff --git a/src/styles/v2-home.css b/src/styles/v2-home.css
index b0a641b..87f1140 100644
--- a/src/styles/v2-home.css
+++ b/src/styles/v2-home.css
@@ -867,4 +867,172 @@
     border-right: 0;
     border-radius: 0;
   }
+}
+/* ============================================================
+   The homepage top (HomeStorefront.jsx): white with an orange accent — a
+   palette of its own, scoped to .hx. No --slv2-* token is redefined and no
+   rule here reaches outside .hx, so no other page or storefront changes.
+   Orange and text, measured (WCAG 2.x): white on the deep orange #C2500A is
+   4.72:1 (the buttons); the deep orange on white is 4.72:1 (the highlighted
+   headline line); near-black #1D1D1B on the bright orange #F47B20 is 6.19:1
+   (the Fashion tile). The bright orange never carries white text.
+   ============================================================ */
+.hx { --hx-orange: #F47B20; --hx-orange-deep: #C2500A; --hx-ink: #1D1D1B; --hx-muted: #5C5853; --hx-soft: #F5F4F2; --hx-line: #ECE8E2; background: #fff; color: var(--hx-ink); }
+.hx *, .hx *::before, .hx *::after { box-sizing: border-box; }
+.hx a { color: inherit; text-decoration: none; }
+.hx-wrap { width: 100%; max-width: 1240px; margin-inline: auto; padding-inline: 28px; }
+.hx .hx-eyebrow { margin: 0 0 14px; font: 600 11px/1.6 var(--slv2-sans); letter-spacing: .16em; text-transform: uppercase; color: var(--hx-ink); }
+.hx .hx-btn { display: inline-flex; align-items: center; gap: 10px; min-height: 48px; padding: 12px 26px; border-radius: 999px; background: var(--hx-orange-deep); color: #fff; font: 600 15px/1.2 var(--slv2-sans); white-space: nowrap; }
+.hx .hx-btn--light { background: #fff; color: var(--hx-ink); }
+.hx-btn svg { flex: none; transition: transform .3s ease; }
+.hx :focus-visible { outline: 2px solid var(--hx-orange-deep); outline-offset: 3px; }
+
+/* ---- the hero: the photograph right-aligned on white, its left edge feathered
+   into the white; the copy over the empty left. Height from the width. ---- */
+.hx-hero { position: relative; overflow: hidden; }
+.hx-hero__viewport { overflow: hidden; touch-action: pan-y; }
+.hx-hero__track { display: flex; transition: transform .6s ease; }
+.hx-hero__slide { position: relative; display: flex; align-items: center; flex: 0 0 100%; min-width: 0; height: clamp(440px, 40vw, 600px); overflow: hidden; background: #fff; }
+.hx-hero__image { position: absolute; top: 0; right: 0; width: auto; height: 100%; max-width: none; -webkit-mask-image: linear-gradient(90deg, transparent 0, #000 14%); mask-image: linear-gradient(90deg, transparent 0, #000 14%); }
+.hx-hero__copy { position: relative; z-index: 1; }
+.hx-hero__copy > * { max-width: min(46%, 520px); }
+.hx-hero__slide--biosash .hx-hero__copy > * { max-width: min(32%, 400px); }
+.hx-hero__title { margin: 0 0 28px; font-family: var(--slv2-disp); font-size: clamp(38px, 4.4vw, 60px); font-weight: 500; line-height: 1.06; letter-spacing: -.02em; color: var(--hx-ink); }
+.hx-hero__title span { display: block; }
+.hx .hx-hl { color: var(--hx-orange-deep); }
+.hx-hero__dots { position: absolute; left: 0; right: 0; bottom: 14px; display: flex; justify-content: center; gap: 4px; }
+.hx-hero__dot { position: relative; width: 28px; height: 28px; padding: 0; border: 0; background: none; cursor: pointer; }
+.hx-hero__dot::after { content: ''; position: absolute; inset: 9px; border-radius: 50%; background: #CFCAC3; }
+.hx-hero__dot.is-on::after { background: var(--hx-orange); }
+
+/* ---- the trust strip: four facts in a row ---- */
+.hx-trust { border-block: 1px solid var(--hx-line); }
+.hx-trust__list { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); margin-block: 0; padding-block: 18px; list-style: none; }
+.hx-trust__list li { display: flex; justify-content: center; min-width: 0; border-right: 1px solid var(--hx-line); }
+.hx-trust__list li:last-child { border-right: 0; }
+.hx-trust__list a, .hx-trust__item { display: flex; align-items: center; gap: 12px; min-height: 44px; padding: 4px 12px; }
+.hx-trust svg { flex: none; color: var(--hx-orange-deep); }
+.hx-trust strong { display: block; font: 600 14px/1.3 var(--slv2-sans); }
+.hx-trust small { display: block; margin-top: 2px; font-size: 12.5px; line-height: 1.3; color: var(--hx-muted); }
+
+/* ---- the tiles: Fashion, large, beside two stacked ---- */
+.hx-tiles { padding-block: 32px 8px; }
+.hx-tiles__grid { display: grid; grid-template-columns: 1.15fr 1fr; grid-template-rows: repeat(2, minmax(208px, auto)); gap: 16px; }
+.hx-tile { position: relative; isolation: isolate; display: block; min-width: 0; overflow: hidden; border-radius: 16px; background: var(--hx-soft); }
+.hx-tile__h { margin: 0; font-family: var(--slv2-disp); font-weight: 500; letter-spacing: -.01em; color: var(--hx-ink); }
+.hx-tile__h span { display: block; }
+.hx-tile__image { transition: transform .5s ease; }
+.hx-tile--fashion { grid-row: 1 / 3; display: grid; grid-template-columns: 46% 54%; min-height: 432px; background: var(--hx-orange); }
+.hx-tile__panel { display: flex; flex-direction: column; align-items: flex-start; justify-content: center; gap: 26px; padding: 32px; }
+.hx-tile--fashion .hx-tile__h { font-size: clamp(30px, 3.2vw, 46px); line-height: 1.06; }
+.hx-tile__art { position: relative; display: block; overflow: hidden; }
+.hx-tile__art .hx-tile__image { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: right top; }
+.hx-tile--small { display: flex; flex-direction: column; align-items: flex-start; justify-content: space-between; padding: 24px; min-height: 208px; }
+.hx-tile--small .hx-tile__image { position: absolute; inset: 0; z-index: -1; width: 100%; height: 100%; object-fit: cover; object-position: right center; }
+.hx-tile--small .hx-tile__h { font-size: clamp(22px, 2vw, 28px); line-height: 1.15; }
+.hx-tile__go { display: grid; place-items: center; width: 42px; height: 42px; border: 1.5px solid var(--hx-ink); border-radius: 50%; transition: transform .3s ease; }
+
+/* ---- explore the stores: five circles ---- */
+.hx-stores { padding-block: 44px 16px; }
+.hx-stores__head { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; margin-bottom: 28px; }
+.hx-stores__h { margin: 0; font-family: var(--slv2-disp); font-size: clamp(26px, 2.6vw, 34px); font-weight: 500; line-height: 1.15; color: var(--hx-ink); }
+.hx-stores__h::after { content: ''; display: block; width: 44px; height: 3px; margin-top: 10px; border-radius: 2px; background: var(--hx-orange); }
+.hx .hx-more { display: inline-flex; align-items: center; gap: 6px; padding-block: 4px; font: 600 15px/1.2 var(--slv2-sans); color: var(--hx-orange-deep); white-space: nowrap; }
+.hx-stores__row { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 20px; margin: 0; padding: 0; list-style: none; }
+.hx-store { display: grid; justify-items: center; gap: 12px; text-align: center; }
+.hx-store__art { display: block; width: min(100%, 160px); aspect-ratio: 1; overflow: hidden; border-radius: 50%; background: #F1EFEC; }
+/* The shots are on white: multiplied onto the disc, the white takes the disc's grey and the circle reads. */
+.hx-store__image { display: block; width: 100%; height: 100%; object-fit: cover; mix-blend-mode: multiply; transition: transform .5s ease; }
+.hx-store__name { font: 500 15px/1.3 var(--slv2-sans); }
+
+/* ---- the promo strip: the copy in the photograph's clear centre ---- */
+.hx-promo { padding-block: 28px 44px; }
+.hx-promo__card { position: relative; isolation: isolate; display: flex; align-items: center; justify-content: center; height: clamp(220px, 22vw, 300px); overflow: hidden; border-radius: 16px; background: #F6EFE6; text-align: center; }
+.hx-promo__image { position: absolute; inset: 0; z-index: -1; width: 100%; height: 100%; object-fit: cover; object-position: center; }
+.hx-promo__copy { display: grid; justify-items: center; gap: 10px; max-width: 46%; padding: 20px; }
+.hx-promo__h { margin: 0; font-family: var(--slv2-disp); font-size: clamp(28px, 3vw, 42px); font-weight: 500; line-height: 1.1; color: var(--hx-ink); }
+.hx-promo__text { margin: 0 0 8px; font-size: 15px; line-height: 1.5; color: var(--hx-muted); }
+
+@media (hover: hover) and (pointer: fine) {
+  .hx .hx-btn:hover svg, .hx-tile:hover .hx-tile__go { transform: translateX(3px); }
+  .hx-tile:hover .hx-tile__image, .hx-store:hover .hx-store__image { transform: scale(1.04); }
+}
+@media (max-width: 700px) {
+  .hx-wrap { padding-inline: 16px; }
+  /* The hero, as in the mockup: ONE compact block. Eyebrow, headline and button in the left
+     45%; the lineup fills the right of the same block to its edge (the photograph's empty
+     white runs under the copy); the dots at its foot, over the photograph. */
+  .hx-hero__slide { height: clamp(190px, 51vw, 340px); }
+  /* The first lineup a little larger, anchored at the foot, so it starts at the 45% line; the
+     Biosash lineup is wider and stays at the block's height, clear of its title. */
+  .hx-hero__slide--everyday .hx-hero__image { top: auto; bottom: 0; height: 116%; }
+  .hx-hero__copy > *, .hx-hero__slide--biosash .hx-hero__copy > * { max-width: 46%; }
+  .hx-hero__copy > .hx-eyebrow { max-width: 64%; }
+  .hx-hero__slide--biosash .hx-hero__copy > .hx-hero__title { max-width: 36%; }
+  .hx .hx-eyebrow { margin-bottom: 8px; font-size: 9.5px; line-height: 1.45; letter-spacing: .1em; }
+  .hx-eyebrow > span { display: block; }
+  .hx-eyebrow__dot { display: none; }
+  .hx-hero__title { margin-bottom: 12px; font-size: clamp(18px, 5.2vw, 30px); line-height: 1.12; }
+  .hx .hx-btn { min-height: 34px; gap: 6px; padding: 7px 14px; font-size: 12.5px; }
+  .hx .hx-btn svg { width: 14px; height: 14px; }
+  .hx-hero__dots { left: 50%; right: auto; bottom: 0; gap: 0; }
+  .hx-hero__dot { width: 22px; height: 22px; }
+  .hx-hero__dot::after { inset: 7px; }
+  /* One row of four across the full width, as in the mockup: each item its icon and two short
+     lines beside it (a title in two parts drops its note). Where four cannot fit (under about
+     340px) the row scrolls, the cut item at the edge its cue. */
+  .hx-trust { border-block: 0; }
+  .hx-trust__list { display: flex; justify-content: space-between; padding-block: 8px; overflow-x: auto; scrollbar-width: none; }
+  .hx-trust__list li { flex: 1 1 auto; }
+  .hx-trust__list li:first-child { justify-content: flex-start; }
+  .hx-trust__list li:last-child { justify-content: flex-end; }
+  .hx-trust__list a, .hx-trust__item { gap: 5px; min-height: 34px; padding: 0 5px; }
+  .hx-trust__list li:first-child > * { padding-left: 0; }
+  .hx-trust__list li:last-child > * { padding-right: 0; }
+  .hx-trust svg { width: 19px; height: 19px; }
+  .hx-trust strong, .hx-trust small { margin: 0; font: 500 clamp(8.5px, 2.5vw, 11px)/1.3 var(--slv2-sans); color: var(--hx-ink); white-space: nowrap; }
+  .hx-trust strong > span { display: block; }
+  .hx-trust--split small { display: none; }
+  .hx-tiles { padding-block: 8px 0; }
+  /* Side by side, as in the mockup: Fashion the wider left tile at full height, the two others
+     stacked to its right, each half its height. */
+  .hx-tiles__grid { grid-template-columns: minmax(0, 1.17fr) minmax(0, 1fr); grid-template-rows: repeat(2, clamp(72px, 19.5vw, 140px)); gap: 8px; }
+  .hx-tile { border-radius: 10px; }
+  /* Fashion is ONE tile: the portrait, on the tile's own orange, fills it from the right with
+     her head at its top edge; the headline and the white button over the orange on the left. */
+  .hx-tile--fashion { display: block; min-height: 0; }
+  .hx-tile--fashion .hx-tile__art { position: absolute; inset: 0; }
+  .hx-tile__art .hx-tile__image { inset: 0 -26% auto auto; width: auto; max-width: none; height: 168%; }
+  .hx-tile__panel { position: relative; z-index: 1; height: 100%; justify-content: center; gap: 10px; padding: 12px; }
+  .hx-tile--fashion .hx-tile__h { font-size: clamp(17px, 4.9vw, 28px); line-height: 1.05; }
+  .hx .hx-tile--fashion .hx-btn { min-height: 30px; gap: 5px; padding: 6px 11px; font-size: 11.5px; }
+  /* Each photograph whole, at the tile's height on the right, its white multiplied into the
+     tile's grey; the label at the top left, the round arrow under it. */
+  .hx-tile--small { min-height: 0; padding: 8px 10px; }
+  .hx-tile--small .hx-tile__image { inset: -8% 0 auto auto; width: auto; height: 116%; mix-blend-mode: multiply; }
+  .hx-tile--small .hx-tile__h { position: relative; font-size: clamp(13px, 3.6vw, 20px); line-height: 1.12; }
+  .hx-tile__go { position: relative; width: 24px; height: 24px; border-width: 1.2px; }
+  .hx-tile__go svg { width: 12px; height: 12px; }
+  /* Five circles in one row, the heading and "View All" on one line above them. */
+  .hx-stores { padding-block: 18px 2px; }
+  .hx-stores__head { margin-bottom: 12px; }
+  .hx-stores__h { font-size: 19px; }
+  .hx-stores__h::after { width: 26px; height: 2.5px; margin-top: 6px; }
+  .hx .hx-more { gap: 4px; font-size: 12.5px; }
+  .hx-stores__row { gap: 8px; }
+  /* Each circle its column's width; a longer name overhangs its column, centred, never widening it. */
+  .hx-store { grid-template-columns: minmax(0, 1fr); gap: 6px; }
+  .hx-store__name { font-size: clamp(9.5px, 2.75vw, 13px); white-space: nowrap; }
+  /* The whole photograph, uncropped at its own 3:1: the gift box on the left, the diya and
+     marigolds on the right, the copy in the clear centre between them. */
+  .hx-promo { padding-block: 14px 26px; }
+  .hx-promo__card { height: auto; aspect-ratio: 3 / 1; border-radius: 10px; text-align: left; }
+  .hx-promo__copy { position: absolute; inset: 0 19% 0 31%; max-width: none; align-content: center; justify-items: start; gap: 4px; padding: 0; }
+  .hx-promo__h { font-size: clamp(16px, 4.7vw, 26px); }
+  .hx-promo__text { margin: 0 0 4px; font-size: clamp(9.5px, 2.7vw, 13px); line-height: 1.35; }
+  .hx.hx-promo .hx-btn { min-height: 28px; gap: 5px; padding: 5px 12px; font-size: 11.5px; }
+}
+@media (prefers-reduced-motion: reduce) {
+  .hx-hero__track, .hx-tile__image, .hx-store__image, .hx-btn svg, .hx-tile__go { transition: none; }
+  .hx .hx-btn:hover svg, .hx-tile:hover .hx-tile__go, .hx-tile:hover .hx-tile__image, .hx-store:hover .hx-store__image { transform: none; }
 }
