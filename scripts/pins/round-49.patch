+/* ============================================================
+   New in Jewellery (2026-11-25): Kiara Jewels and Joiya Jewellery. A champagne band and a
+   bento of five photographs (square edges, as all of the homepage's .hx sections), so it does not read as a fourth poster row after Taj Leather and
+   Ansari Fashion. Only transform animates (the photograph's slow zoom and the arrow), and not
+   at all for reduced motion. Text over photographs sits on a dark scrim: white on it ≥ 7:1.
+   ============================================================ */
+.hx.hx-nj { position: relative; padding: 56px 0 60px; background: linear-gradient(180deg, #FBF6EE 0%, #F4EADB 100%); }
+.hx.hx-nj::before { content: ''; position: absolute; left: 50%; top: 0; width: min(1184px, calc(100% - 56px)); height: 1px; transform: translateX(-50%); background: linear-gradient(90deg, transparent, #C9A46A, transparent); }
+.hx-nj__head { display: flex; align-items: flex-end; justify-content: space-between; gap: 18px 28px; flex-wrap: wrap; margin-bottom: 24px; }
+.hx-nj__eyebrow { margin: 0 0 8px; font: 700 12px/1.2 Arial, sans-serif; letter-spacing: .16em; text-transform: uppercase; color: #8A6A3C; }
+.hx-nj__h { margin: 0; font-family: var(--slv2-serif, Georgia, serif); font-size: clamp(30px, 3.6vw, 44px); font-weight: 500; line-height: 1.05; color: #1D1D1B; }
+.hx-nj__text { margin: 10px 0 0; max-width: 520px; font: 15px/1.55 Arial, sans-serif; color: #5C5853; }
+.hx-nj__actions { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; }
+.hx.hx-nj .hx-nj__brand { display: inline-flex; align-items: center; min-height: 44px; padding: 10px 18px; border: 1px solid #C9A46A; font: 600 14px/1.2 Arial, sans-serif; color: #5E4521; background: rgba(255, 255, 255, .6); transition: background-color .2s ease, color .2s ease; }
+.hx.hx-nj .hx-nj__brand:hover { background: #fff; color: #3B2A12; }
+.hx.hx-nj .hx-nj__cta { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; padding: 10px 20px; font: 700 14px/1.2 Arial, sans-serif; color: #fff; background: #1F3A2E; }
+.hx.hx-nj .hx-nj__cta:hover { background: #142A20; }
+.hx-nj__cta svg, .hx-nj__name svg { flex: none; transition: transform .3s ease; }
+.hx-nj__cta:hover svg, .hx-nj__tile:hover .hx-nj__name svg { transform: translateX(3px); }
+.hx-nj__grid { list-style: none; margin: 0; padding: 0; display: grid; gap: 14px; grid-template-columns: repeat(4, minmax(0, 1fr)); grid-auto-rows: clamp(250px, 24vw, 330px); }
+.hx-nj__cell--lead { grid-column: span 2; grid-row: span 2; }
+.hx-nj__tile { position: relative; display: block; height: 100%; overflow: hidden; background: #EADFCB; box-shadow: 0 18px 40px -28px rgba(59, 42, 18, .55); }
+.hx-nj__tile img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: center 30%; transition: transform .8s cubic-bezier(.2, .8, .2, 1); }
+.hx-nj__tile:hover img { transform: scale(1.05); }
+.hx-nj__label { position: absolute; left: 0; right: 0; bottom: 0; display: grid; gap: 6px; padding: 64px 18px 18px; background: linear-gradient(transparent, rgba(22, 14, 6, .84)); }
+.hx-nj__chip { justify-self: start; padding: 4px 10px; font: 700 10.5px/1.2 Arial, sans-serif; letter-spacing: .1em; text-transform: uppercase; color: #F7E7C6; background: rgba(0, 0, 0, .35); box-shadow: inset 0 0 0 1px rgba(247, 231, 198, .35); }
+.hx.hx-nj .hx-nj__name { display: flex; align-items: center; justify-content: space-between; gap: 8px; font-family: var(--slv2-serif, Georgia, serif); font-size: 22px; font-weight: 500; line-height: 1.15; color: #fff; text-shadow: 0 1px 2px rgba(0, 0, 0, .35); }
+.hx-nj__cell--lead .hx-nj__label { padding: 90px 26px 26px; }
+.hx.hx-nj .hx-nj__cell--lead .hx-nj__name { font-size: clamp(28px, 2.8vw, 38px); }
+.hx-nj__tile:focus-visible { outline: 3px solid #8A6A3C; outline-offset: 3px; }
+@media (max-width: 899px) {
+  .hx.hx-nj { padding: 40px 0 44px; }
+  .hx-nj__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); grid-auto-rows: auto; gap: 10px; }
+  .hx-nj__cell--lead { grid-row: auto; }
+  .hx-nj__tile { aspect-ratio: 3 / 4; height: auto; }
+  .hx-nj__cell--lead .hx-nj__tile { aspect-ratio: 4 / 3.4; }
+  .hx-nj__label { padding: 48px 12px 12px; gap: 5px; }
+  .hx.hx-nj .hx-nj__name { font-size: 18px; }
+  .hx-nj__chip { font-size: 9.5px; padding: 3px 8px; }
+  .hx-nj__cell--lead .hx-nj__label { padding: 60px 16px 16px; }
+  .hx.hx-nj .hx-nj__cell--lead .hx-nj__name { font-size: 26px; }
+}
+@media (max-width: 599px) {
+  .hx-nj__actions { width: 100%; }
+  .hx.hx-nj .hx-nj__brand { flex: 1 1 0; justify-content: center; padding: 10px 12px; }
+  .hx.hx-nj .hx-nj__cta { flex: 1 1 100%; justify-content: center; }
+}
+@media (prefers-reduced-motion: reduce) {
+  .hx-nj__tile img, .hx-nj__cta svg, .hx-nj__name svg { transition: none; }
+  .hx-nj__tile:hover img { transform: none; }
+}
 .hx-brands__grid { list-style: none; margin: 18px 0 32px; padding: 0; display: grid; gap: 16px; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); }
