+@media (min-width: 768px) { .hx-ios { align-items: center; } }
+.hx-update { position: fixed; left: 50%; top: calc(12px + env(safe-area-inset-top, 0px)); transform: translateX(-50%); z-index: 110; display: flex; align-items: center; gap: 10px; width: max-content; max-width: calc(100vw - 24px); padding: 10px 8px 10px 14px; background: #1E3A2F; color: #fff; font: 400 14px/1.3 Arial, "Helvetica Neue", Helvetica, sans-serif; box-shadow: 0 10px 28px rgba(15, 17, 17, .28); }
+.hx-update button { height: 30px; padding: 0 12px; border: 1px solid #fff; background: #fff; color: #1E3A2F; font: 700 13px Arial, sans-serif; cursor: pointer; }
+.hx-update .hx-update__x { width: 30px; padding: 0; display: grid; place-items: center; border: 0; background: transparent; color: #fff; }
+.hx-appback { position: fixed; left: 12px; bottom: calc(12px + var(--app-foot, 0px) + env(safe-area-inset-bottom, 0px)); z-index: 55; display: inline-flex; align-items: center; gap: 2px; height: 40px; padding: 0 12px 0 8px; border: 1px solid #D5D9D9; background: rgba(255, 255, 255, .96); color: #0F1111; font: 600 14px Arial, "Helvetica Neue", Helvetica, sans-serif; box-shadow: 0 6px 18px rgba(15, 17, 17, .18); cursor: pointer; }
+.hx-appback:focus-visible { outline: 2px solid #0F1111; outline-offset: 3px; }
+@media print { .hx-appback, .hx-update, .hx-acard { display: none; } }
