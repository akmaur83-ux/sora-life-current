+.pdpk-about ul { margin: 0; padding-left: 18px; display: grid; gap: 6px; list-style: disc; }
+.pdpk-about li { font-size: 14px; line-height: 1.45; color: #0F1111; }
+.pdp__bbwish { display: flex; align-items: center; justify-content: center; gap: 6px; width: 100%; min-height: 34px; margin-top: 10px; border: 1px solid #D5D9D9; background: #fff; color: #0F1111; font: inherit; font-size: 13px; cursor: pointer; }
+.pdp__bbwish.is-on { color: #C2500A; border-color: #C2500A; }
+.pdp__bbsecure { display: flex; align-items: center; gap: 5px; margin: 10px 0 0; font-size: 12.5px; color: #007185; }
+
+/* Compare with similar items, and the service cards (owner, 2026-11-08). */
+.pdpk-h--lg { font-size: 20px; }
+.pdpk-cmp { margin-top: 28px; padding-top: 18px; border-top: 1px solid #E7E7E7; }
+.pdpk-cmp__scroll { overflow-x: auto; }
+.pdpk-cmp table { width: 100%; min-width: 620px; border-collapse: collapse; font-size: 14px; color: #0F1111; }
+.pdpk-cmp th, .pdpk-cmp td { padding: 9px 12px; border-bottom: 1px solid #E7E7E7; text-align: left; vertical-align: top; }
+.pdpk-cmp tbody th { width: 120px; font-weight: 700; }
+.pdpk-cmp thead th { width: 22%; font-weight: 400; }
+.pdpk-cmp .is-current { background: #F7FAFA; }
+.pdpk-cmp__item { display: grid; gap: 6px; color: #007185; text-decoration: none; font-size: 13.5px; line-height: 1.35; }
+.pdpk-cmp__item img { width: 110px; height: 110px; object-fit: contain; background: #fff; }
+.pdpk-cmp__item em { font-style: normal; font-size: 12px; font-weight: 700; color: #565959; }
+.pdpk-cmp__price { font-size: 16px; font-weight: 500; }
+.pdpk-cmp__off { color: #CC0C39; }
+.pdpk-cmp s { color: #565959; }
+.pdpk-svc { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; margin-top: 24px; padding-top: 18px; border-top: 1px solid #E7E7E7; }
+.pdpk-svc > div { padding: 14px 16px; border: 1px solid #D5D9D9; background: #fff; }
+.pdpk-svc .pdpk-h { display: flex; align-items: center; gap: 8px; font-size: 15px; }
+.pdpk-svc .pdpk-h svg { color: #007185; }
+.pdpk-svc ul { margin: 0; padding: 0; list-style: none; display: grid; gap: 5px; font-size: 13.5px; line-height: 1.45; color: #0F1111; }
+.pdpk-svc a { color: #007185; }
+@media (max-width: 767px) { .pdpk-svc { grid-template-columns: minmax(0, 1fr); } .pdpk-cmp table { font-size: 13px; } }
+
+/* More from the brand, frequently bought together, product information (owner, 2026-11-08). */
+.pdpk-rail, .pdpk-fbt, .hl-info { margin-top: 28px; padding-top: 18px; border-top: 1px solid #E7E7E7; }
+.pdpk-rail__row { display: grid; grid-auto-flow: column; grid-auto-columns: 170px; justify-content: start; gap: 16px; margin: 0; padding: 0 0 6px; list-style: none; overflow-x: auto; }
+.pdpk-rail__card, .pdpk-fbt__item { display: grid; gap: 5px; color: #0F1111; text-decoration: none; }
+.pdpk-rail__img { display: block; aspect-ratio: 1; background: #F7F8F8; overflow: hidden; }
+.pdpk-rail__img img { width: 100%; height: 100%; object-fit: contain; }
+.pdpk-rail__name { font-size: 13.5px; line-height: 1.35; color: #007185; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
+.pdpk-rail__price { display: flex; gap: 6px; align-items: baseline; font-size: 16px; }
+.pdpk-rail__price i { font-style: normal; color: #CC0C39; font-size: 14px; }
+.pdpk-rail__price b { font-weight: 500; }
+.pdpk-rail__mrp { font-size: 12px; color: #565959; }
+.pdpk-fbt__body { display: flex; flex-wrap: wrap; align-items: center; gap: 20px 32px; }
+.pdpk-fbt__items { display: flex; flex-wrap: wrap; align-items: flex-start; gap: 10px; margin: 0; padding: 0; list-style: none; }
+.pdpk-fbt__items li { display: flex; align-items: center; gap: 10px; width: 190px; }
+.pdpk-fbt__items li:not(:first-child) { width: 216px; }
+.pdpk-fbt__plus { font-size: 24px; color: #565959; }
+.pdpk-fbt__item { width: 160px; }
+.pdpk-fbt__buy p { margin: 0 0 10px; font-size: 16px; color: #0F1111; }
+.pdpk-fbt__btn { min-height: 38px; padding: 0 18px; border: 1px solid #1E5A35; background: #1E5A35; color: #fff; font: inherit; font-size: 14px; cursor: pointer; }
+
+/* Share, quantity, hover zoom (owner, 2026-11-08). */
+.pdpk-share { display: flex; align-items: center; gap: 10px; margin-top: 10px; font-size: 12.5px; color: #565959; }
+.pdpk-share a, .pdpk-share button { padding: 0; border: 0; background: none; font: inherit; color: #007185; cursor: pointer; text-decoration: none; }
+.pdpk-share a:hover, .pdpk-share button:hover { text-decoration: underline; }
+.hl-qty { display: flex; align-items: center; gap: 6px; margin: 0 0 10px; font-size: 13px; color: #0F1111; }
+.hl-qty select { height: 32px; padding: 0 8px; border: 1px solid #D5D9D9; background: #F0F2F2; font: inherit; }
+.pdp__main img, .hl-gallery__slide img { transition: transform .12s ease-out; }
+.pdp__main, .hl-gallery__slide { overflow: hidden; }
