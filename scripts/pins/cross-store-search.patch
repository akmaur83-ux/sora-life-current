+.hx-suggest__none { margin: 0; padding: 12px; font-size: 14px; color: #565959; }
+/* One search across the stores (2026-11-08): the header's second group and the /shop?q= section. */
+.hx-xsg { border-top: 1px solid #E7E7E7; padding: 6px 0 2px; font-family: Arial, "Helvetica Neue", Helvetica, sans-serif; }
+.hx-xsg__h { margin: 4px 12px 4px; font-size: 11px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: #565959; }
+.hx-xsg__item { display: grid; grid-template-columns: 40px minmax(0, 1fr) auto; align-items: center; gap: 10px; padding: 6px 12px; color: #0F1111; text-decoration: none; font-size: 13px; }
+.hx-xsg__item:hover { background: #F3F6F6; }
+.hx-xsg__img { width: 40px; height: 40px; display: block; background: #fff; }
+.hx-xsg__img img { width: 100%; height: 100%; object-fit: contain; display: block; }
+.hx-xsg__name { min-width: 0; line-height: 1.3; overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
+.hx-xsg__name em { display: block; font-style: normal; font-size: 11px; color: #007185; }
+.hx-xsg--sheet { margin-top: 10px; }
+.hx-xs { margin-top: 36px; margin-bottom: 40px; font-family: Arial, "Helvetica Neue", Helvetica, sans-serif; }
+.hx-xs__h { margin: 0 0 16px; padding-top: 22px; border-top: 1px solid #E7E7E7; font-size: 22px; font-weight: 700; color: #0F1111; }
+.hx-xs__h span { display: block; margin-top: 4px; font-size: 14px; font-weight: 400; color: #565959; }
+.hx-xs__grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(170px, 1fr)); gap: 16px; margin: 0; padding: 0; list-style: none; }
+.hx-xs__card { display: grid; gap: 4px; color: #0F1111; text-decoration: none; }
+.hx-xs__img { display: block; aspect-ratio: 1; background: #F7F7F7; }
+.hx-xs__img img { width: 100%; height: 100%; object-fit: contain; display: block; }
+.hx-xs__store { font-size: 11px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: #007185; }
+.hx-xs__name { font-size: 14px; line-height: 1.35; overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
+.hx-xs__card:hover .hx-xs__name { color: #C7511F; text-decoration: underline; }
+.hx-xs__price { display: flex; align-items: baseline; gap: 6px; font-size: 16px; }
+.hx-xs__price s { font-size: 12px; color: #565959; }
+@media (max-width: 599px) { .hx-xs__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; } .hx-xs__h { font-size: 19px; } }
