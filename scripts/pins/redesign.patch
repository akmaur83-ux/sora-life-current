diff --git a/src/styles/sora-ds.css b/src/styles/sora-ds.css
new file mode 100644
index 0000000..4e926a8
--- /dev/null
+++ b/src/styles/sora-ds.css
@@ -0,0 +1,191 @@
+/* ============================================================
+   SORA design system (2026-11-13 redesign: one look across the stores).
+   Loaded last of the storefront sheets, before the admin's per-section settings.
+
+   The palette, once:
+     forest  #1E3A2F  primary: buttons, active tabs, the store bar
+     forest2 #2C5341  links and "View all"
+     honey   #8A5A12  hover on links
+     warm    #C2500A  the accent rule under section headings, small highlights
+     cream   #FBF8F1  warm surfaces
+     ink     #0F1111 / muted #565959 / line #E3E6E6
+
+   What it unifies here (the stores' own sheets keep everything else):
+     * section headings — a serif heading with the short warm rule under it, the
+       homepage's "Explore the stores" style, now in Fashion and Home & Living too;
+     * breadcrumbs — one size, one colour, the same separator, on every store;
+     * skeleton loading — shimmering placeholders while a list loads (.sora-skel);
+     * the reveal — sections rise in softly once (.sora-reveal), never under
+       prefers-reduced-motion.
+   Fashion and Home & Living sheets load after this one (deferred), so the few
+   rules that must win there are prefixed with body to outrank them.
+   ============================================================ */
+:root {
+  --sora-forest: #1E3A2F;
+  --sora-forest-2: #2C5341;
+  --sora-honey: #8A5A12;
+  --sora-warm: #C2500A;
+  --sora-cream: #FBF8F1;
+  --sora-ink: #0F1111;
+  --sora-muted: #565959;
+  --sora-line: #E3E6E6;
+}
+
+/* Section headings: serif, the short warm rule. */
+body .fs-sec__h::after,
+body .hl .hl-sec__h::after { content: ''; display: block; width: 44px; height: 3px; margin-top: 10px; background: var(--sora-warm); }
+body .hl .hl-sec__h--rule { padding-bottom: 0; }
+body .hl .hl-sec__h--rule::after { position: static; width: 44px; height: 3px; background: var(--sora-warm); }
+body .hl .hl-sec__link, body .fs-sec__more { color: var(--sora-forest-2); }
+@media (max-width: 767px) {
+  body .fs-sec__h::after, body .hl .hl-sec__h::after { width: 26px; height: 2.5px; margin-top: 6px; }
+}
+
+/* Breadcrumbs: one look on every store. */
+body .crumbs, body .fs-crumb ol, body .hl .hl-crumb ol, body .hx-offers__crumbs, body .info .v2-crumbs { font-size: 13px; color: var(--sora-muted); letter-spacing: 0; }
+body .crumbs a, body .fs-crumb a, body .hl .hl-crumb a, body .hx-offers__crumbs a, body .info .v2-crumbs a { color: var(--sora-forest-2); text-decoration: none; }
+body .crumbs a:hover, body .fs-crumb a:hover, body .hl .hl-crumb a:hover, body .hx-offers__crumbs a:hover, body .info .v2-crumbs a:hover { color: var(--sora-honey); text-decoration: underline; }
+body .crumbs span, body .fs-crumb [aria-current], body .hl .hl-crumb [aria-current], body .hx-offers__crumbs span { color: var(--sora-ink); font-weight: 600; }
+body .pagehead .crumbs { font-size: 13px; letter-spacing: 0; }
+
+/* Skeleton loading. */
+@keyframes sora-shimmer { from { background-position: 200% 0; } to { background-position: -200% 0; } }
+.sora-skel { display: block; background: linear-gradient(90deg, #EEF0F0 25%, #F7F8F8 37%, #EEF0F0 63%); background-size: 400% 100%; animation: sora-shimmer 1.4s ease-in-out infinite; }
+.sora-skel-grid { list-style: none; margin: 0 0 24px; padding: 0; display: grid; gap: 14px; grid-template-columns: repeat(auto-fill, minmax(170px, 1fr)); }
+.sora-skel-card { display: flex; flex-direction: column; gap: 8px; }
+.sora-skel-card .sora-skel--img { aspect-ratio: 1; }
+.sora-skel-card .sora-skel--line { height: 12px; }
+.sora-skel-card .sora-skel--short { height: 12px; width: 55%; }
+.sora-skel-card .sora-skel--price { height: 16px; width: 35%; }
+.sora-sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
+@media (max-width: 600px) { .sora-skel-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; } }
+
+/* The reveal: once, softly; nothing moves for reduced motion. */
+.sora-reveal { opacity: 0; transform: translateY(14px); transition: opacity .55s ease, transform .55s ease; }
+.sora-reveal.is-in { opacity: 1; transform: none; }
+@media (prefers-reduced-motion: reduce) {
+  .sora-skel { animation: none; }
+  .sora-reveal { opacity: 1; transform: none; transition: none; }
+}
+@media print { .sora-reveal { opacity: 1; transform: none; } }
+
+/* The store bar: one slim bar across every store (StoreBar.jsx). */
+.sora-storebar { background: #F3EFE4; border-bottom: 1px solid #E6DFCC; color: var(--sora-forest); font: 500 13px/1 Inter, Arial, "Helvetica Neue", sans-serif; }
+.sora-storebar__in { max-width: 1480px; margin: 0 auto; padding: 0 max(16px, env(safe-area-inset-left, 0px)); display: flex; align-items: stretch; justify-content: space-between; gap: 16px; min-height: 38px; }
+.sora-storebar__stores, .sora-storebar__site { display: flex; align-items: stretch; gap: 2px; }
+.sora-storebar__stores { overflow-x: auto; scrollbar-width: none; }
+.sora-storebar__stores::-webkit-scrollbar { display: none; }
+.sora-storebar__store { display: inline-flex; align-items: center; padding: 0 12px; color: #3E5A4C; text-decoration: none; white-space: nowrap; border-bottom: 2px solid transparent; }
+.sora-storebar__store:hover { color: var(--sora-forest); background: rgba(30, 58, 47, .05); }
+.sora-storebar__store.is-on { color: var(--sora-forest); font-weight: 700; border-bottom-color: var(--sora-warm); background: #fff; }
+.sora-storebar__link { display: inline-flex; align-items: center; gap: 5px; padding: 0 10px; color: #3E5A4C; text-decoration: none; white-space: nowrap; }
+.sora-storebar__link:hover, .sora-storebar__link.is-on { color: var(--sora-forest); text-decoration: underline; text-underline-offset: 3px; }
+.sora-storebar__link svg { color: var(--sora-warm); }
+.sora-storebar a:focus-visible { outline: 2px solid var(--sora-forest); outline-offset: -2px; }
+@media (max-width: 1023px) { .sora-storebar__site { display: none; } .sora-storebar__in { padding: 0; } .sora-storebar__store { padding: 0 14px; } }
+@media print { .sora-storebar { display: none; } }
+/* The links to the other stores inside each store's header: the store bar has them now. */
+body .v2-hdr__stores, body .fs-hdr__stores, body .hl .hl-hdr__stores, body .gs-hdr__stores, body .ls-hdr__stores { display: none !important; }
+/* Room for the Fashion store's phone tab bar. */
+@media (max-width: 900px) { body .fs:has(> .tabbar) .fs-main { padding-bottom: 76px; } }
+
+/* All categories (AllCategories.jsx). */
+.sora-cats__jump { display: flex; gap: 8px; flex-wrap: wrap; margin: 12px 0 8px; }
