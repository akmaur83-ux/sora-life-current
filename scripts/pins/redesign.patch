@@ -0,0 +1,84 @@
+import { useEffect } from 'react';
+import { Link, useSearchParams } from 'react-router-dom';
+import Icon from '../components/Icon.jsx';
+import SkeletonGrid from '../components/Skeleton.jsx';
+import { categories as wellnessCategories } from '../data/categories.js';
+import { products as wellnessProducts } from '../data/products.js';
+import { useHomeLivingCatalogue } from '../data/homelivingHomepage.js';
+import { FashionCatalogueProvider, useFashionCatalogue } from '../fashion/FashionCatalogue.jsx';
+import { fashionGroups, flatTiles } from '../lib/allCategories.js';
+import { usePageMeta } from '../lib/pageMeta.js';
+
+// ============================================================
+// /categories (2026-11-13 redesign): every store's categories on one page, with
+// pictures (allCategories.js says where each picture comes from). ?store=fashion
+// (the Fashion tab bar's "Categories") opens at that store's section.
+// ============================================================
+function Tile({ t, small = false }) {
+  return (
+    <li>
+      <Link to={t.href} className={`sora-cat${small ? ' sora-cat--sm' : ''}`}>
+        <span className="sora-cat__img">{t.image ? <img src={t.image} alt="" width="240" height="240" loading="lazy" decoding="async" /> : <span className="sora-cat__ph" aria-hidden="true">{t.name.slice(0, 1)}</span>}</span>
+        <span className="sora-cat__name">{t.name}</span>
+        {t.count ? <span className="sora-cat__count">{t.count} {t.count === 1 ? 'product' : 'products'}</span> : null}
+      </Link>
+    </li>
+  );
+}
+
+function FashionSection() {
+  const { status, tree, views } = useFashionCatalogue();
+  const groups = fashionGroups(tree, views);
+  return (
+    <section className="sora-cats__store" id="cats-fashion" aria-labelledby="cats-fashion-h">
+      <div className="sora-cats__head"><h2 id="cats-fashion-h">Fashion</h2><Link to="/fashion">Visit the store <Icon name="arrowRight" size={14} /></Link></div>
+      {status === 'loading' && !groups.length ? <SkeletonGrid count={6} label="Loading the Fashion categories…" /> : groups.map((g) => (
+        <div key={g.key} className="sora-cats__group">
+          <h3><Link to={g.href}>{g.name} <Icon name="chevronRight" size={14} /></Link></h3>
+          <ul className="sora-cats__grid">{(g.children.length ? g.children : [g]).map((t) => <Tile key={t.key} t={t} small />)}</ul>
+        </div>
+      ))}
+    </section>
+  );
+}
+
+function HomeLivingSection() {
+  const { status, categories, products } = useHomeLivingCatalogue();
+  const tiles = flatTiles(categories, products, { catOf: (p) => p.category_id, imageOf: (p) => p.images?.[0], href: (c) => `/homeliving/category/${c.slug}`, key: (c) => c.id });
+  return (
+    <section className="sora-cats__store" id="cats-homeliving" aria-labelledby="cats-homeliving-h">
+      <div className="sora-cats__head"><h2 id="cats-homeliving-h">Home &amp; Living</h2><Link to="/homeliving">Visit the store <Icon name="arrowRight" size={14} /></Link></div>
+      {status === 'loading' && !tiles.length ? <SkeletonGrid count={4} label="Loading the Home & Living categories…" /> : <ul className="sora-cats__grid">{tiles.map((t) => <Tile key={t.key} t={t} />)}</ul>}
+    </section>
+  );
+}
+
+export default function AllCategories() {
+  const [params] = useSearchParams();
+  const want = params.get('store');
+  usePageMeta({ title: 'All categories', description: 'Every category at SORA LIFESTYLE: wellness, fashion and home, in one place.', path: '/categories' });
+  const wellness = flatTiles(wellnessCategories, wellnessProducts, { catOf: (p) => p.category, imageOf: (p) => p.image, href: (c) => `/category/${c.slug}`, key: (c) => c.slug });
+  useEffect(() => {
+    if (!want) return undefined;
+    const t = setTimeout(() => document.getElementById(`cats-${want}`)?.scrollIntoView({ block: 'start' }), 400);
+    return () => clearTimeout(t);
+  }, [want]);
+  return (
+    <div className="hx sora-cats">
+      <div className="hx-wrap">
+        <nav className="hx-offers__crumbs" aria-label="Breadcrumb"><Link to="/">Home</Link> <Icon name="chevronRight" size={12} /> <span>All categories</span></nav>
+        <h1 className="hx-offers__h">All categories</h1>
+        <p className="hx-offers__lede">Everything at SORA LIFESTYLE, store by store.</p>
+        <nav className="sora-cats__jump" aria-label="Stores">
+          <a href="#cats-wellness">Wellness</a><a href="#cats-fashion">Fashion</a><a href="#cats-homeliving">Home &amp; Living</a><Link to="/grocery">Grocery</Link><Link to="/lifestyle">Lifestyle</Link>
+        </nav>
+        <section className="sora-cats__store" id="cats-wellness" aria-labelledby="cats-wellness-h">
+          <div className="sora-cats__head"><h2 id="cats-wellness-h">Wellness &amp; beauty</h2><Link to="/shop">Visit the store <Icon name="arrowRight" size={14} /></Link></div>
+          <ul className="sora-cats__grid">{wellness.map((t) => <Tile key={t.key} t={t} />)}</ul>
+        </section>
+        <FashionCatalogueProvider><FashionSection /></FashionCatalogueProvider>
+        <HomeLivingSection />
+      </div>
+    </div>
+  );
+}
diff --git a/src/pages/BrandPage.jsx b/src/pages/BrandPage.jsx
new file mode 100644
index 0000000..6039605
--- /dev/null
+++ b/src/pages/BrandPage.jsx
@@ -0,0 +1,87 @@
+import { Link, useParams, useSearchParams } from 'react-router-dom';
+import Icon from '../components/Icon.jsx';
+import SkeletonGrid from '../components/Skeleton.jsx';
+import LoadMore, { useShowMore } from '../components/LoadMore.jsx';
+import { money } from '../lib/format.js';
+import { products } from '../data/products.js';
+import { categoryBySlug } from '../data/categories.js';
+import { productBrandName } from '../lib/homeMerchandising.js';
+import { BRANDS, brandImage } from '../lib/brands.js';
+import { BRAND_SORTS, useCatalogueBrand, wellnessBrandCards, arrangeBrandCards, brandCategories } from '../lib/brandPage.js';
+import { usePageMeta } from '../lib/pageMeta.js';
+import NotFound from './NotFound.jsx';
+
+// ============================================================
+// /brands/:id — one partner brand's page (2026-11-13 redesign): its banner and
+// story, then everything of theirs that can be bought, by category and sort
+// (brandPage.js has the rules). The link to send a partner, or put in an ad.
+// ============================================================
+const brandOf = (p) => String(p?.brand || productBrandName(p) || '').trim().toLowerCase();
+
+export default function BrandPage() {
+  const { id } = useParams();
+  const brand = BRANDS.find((b) => b.id === id);
+  const [params, setParams] = useSearchParams();
+  const fromCatalogue = useCatalogueBrand(brand?.catalogueBrand || '');
+  const wellness = brand && !brand.catalogueBrand
+    ? wellnessBrandCards(products.map((p) => ({ ...p, categoryName: categoryBySlug[p.category]?.name || '' })), (p) => brandOf(p) === brand.name.toLowerCase())
+    : null;
+  const cards = brand?.catalogueBrand ? fromCatalogue : wellness;
+  const category = params.get('cat') || '';
+  const sort = BRAND_SORTS.some((s) => s.id === params.get('sort')) ? params.get('sort') : 'featured';
+  const shown = cards ? arrangeBrandCards(cards, { category, sort }) : [];
+  const paging = useShowMore(shown.length, `${id}|${category}|${sort}`);
+  usePageMeta({ title: brand ? brand.name : 'Brand', description: brand ? `${brand.name} at SORA LIFESTYLE. ${brand.text}` : '', path: `/brands/${id}` }, [id]);
+  if (!brand) return <NotFound />;
+  const cats = cards ? brandCategories(cards) : [];
+  const set = (k, v) => { const next = new URLSearchParams(params); if (!v || v === 'featured') next.delete(k); else next.set(k, v); setParams(next, { replace: true }); };
+  const hero = brandImage(brand, products, (p) => brandOf(p) === brand.name.toLowerCase());
+  return (
+    <div className={`hx sora-brand${brand.luxe ? ' sora-brand--luxe' : ''}`}>
+      <div className="hx-wrap">
+        <nav className="hx-offers__crumbs" aria-label="Breadcrumb"><Link to="/">Home</Link> <Icon name="chevronRight" size={12} /> <Link to="/brands">Our brands</Link> <Icon name="chevronRight" size={12} /> <span>{brand.name}</span></nav>
+        <header className="sora-brand__hero">
+          <div className={`sora-brand__img${brand.imageFrom ? ' is-whole' : ''}`}>{hero && <img src={hero} alt="" width="900" height="600" decoding="async" />}</div>
+          <div className="sora-brand__copy">
+            <p className="sora-brand__eyebrow">{brand.store} · on SORA LIFESTYLE</p>
+            <h1>{brand.name}</h1>
+            <p className="sora-brand__story">{brand.story}</p>
+            <p className="sora-brand__count">{cards === null ? 'Loading the range…' : `${cards.length} ${cards.length === 1 ? 'product' : 'products'} available`}</p>
+          </div>
+        </header>
+        <div className="sora-brand__bar">
+          <div className="sora-brand__cats" role="group" aria-label="Category">
+            <button type="button" aria-pressed={!category} className={`hx-offers__chip${!category ? ' is-on' : ''}`} onClick={() => set('cat', '')}>All</button>
+            {cats.map((c) => (
+              <button key={c.name} type="button" aria-pressed={category === c.name} className={`hx-offers__chip${category === c.name ? ' is-on' : ''}`} onClick={() => set('cat', c.name)}>{c.name} <em>{c.count}</em></button>
+            ))}
+          </div>
+          <label className="sora-brand__sort">
+            <span>Sort</span>
+            <select value={sort} onChange={(e) => set('sort', e.target.value)}>
+              {BRAND_SORTS.map((s) => <option key={s.id} value={s.id}>{s.label}</option>)}
+            </select>
+          </label>
+        </div>
+        {cards === null ? <SkeletonGrid label={`Loading ${brand.name}…`} />
+          : shown.length === 0 ? <p className="hx-offers__empty">Nothing of {brand.name}’s is in stock right now. New pieces appear the moment they go live.</p>
+            : (
+              <>
+                <ul className="hx-offers__grid">
+                  {shown.slice(0, paging.shown).map((c, i) => (
+                    <li key={c.key}>
+                      <Link to={c.href} className="hx-deals__card">
+                        <span className={`hx-deals__img${c.whole ? ' sora-brand__whole' : ''}`}><img src={c.image} alt="" width="300" height="300" loading={i < 8 ? 'eager' : 'lazy'} decoding="async" /></span>
+                        <span className="hx-deals__name">{c.name}</span>
+                        <span className="hx-deals__price"><b>{money(c.price)}</b>{c.mrp ? <s>{money(c.mrp)}</s> : null}</span>
+                      </Link>
+                    </li>
+                  ))}
+                </ul>
+                <LoadMore shown={paging.shown} total={shown.length} onMore={paging.more} />
+              </>
+            )}
+      </div>
+    </div>
+  );
+}
