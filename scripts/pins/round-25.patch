+}
+
+/* Winter band, round 25 (owner, 2026-11-20: "live animations ... add krdo"). */
+.sora-winter__snow--near i { opacity: .55; filter: blur(1.6px); animation-name: sw-fall-near; }
+@keyframes sw-fall-near {
+  0% { transform: translate3d(0, 0, 0) scale(1); opacity: 0; }
+  12% { opacity: .6; }
+  50% { transform: translate3d(calc(var(--drift) * -.6), 380px, 0) scale(1.1); }
+  100% { transform: translate3d(var(--drift), 760px, 0) scale(.9); opacity: .15; }
+}
+.sora-winter__deco { position: absolute; inset: 0; pointer-events: none; z-index: 0; }
+/* Ornaments hang from the top edge on a thread and swing. */
+.sora-winter__orn {
+  position: absolute; top: 0; left: var(--x); display: flex; flex-direction: column; align-items: center;
+  transform-origin: 50% 0; animation: sw-swing var(--d) ease-in-out var(--delay) infinite alternate;
+}
+.sora-winter__orn::before { content: ''; width: 1px; height: var(--len); background: linear-gradient(#ffffff00, #E9DCC0); }
+.sora-winter__orn svg { width: 26px; height: 26px; color: #FBF3E4; filter: drop-shadow(0 3px 4px rgba(0, 0, 0, .35)); animation: sw-spin 9s linear infinite; }
+@keyframes sw-swing { from { transform: rotate(-9deg); } to { transform: rotate(9deg); } }
+/* Stars that twinkle. */
+.sora-winter__twinkle {
+  position: absolute; left: var(--x); top: var(--y); width: var(--s); height: var(--s); background: #FFF6DA;
+  clip-path: polygon(50% 0, 61% 39%, 100% 50%, 61% 61%, 50% 100%, 39% 61%, 0 50%, 39% 39%);
+  animation: sw-twinkle 2.6s ease-in-out var(--delay) infinite; opacity: 0;
+}
+@keyframes sw-twinkle { 0%, 100% { opacity: 0; transform: scale(.4) rotate(0); } 50% { opacity: 1; transform: scale(1.2) rotate(45deg); } }
+/* Pom-poms along the hem, bobbing in a wave. */
+.sora-winter__hem { position: relative; z-index: 1; display: flex; justify-content: space-between; padding: 0 6px 6px; margin-top: -2px; }
+.sora-winter__hem i {
+  width: 10px; height: 10px; border-radius: 50%; background: radial-gradient(circle at 35% 35%, #fff, #E6DCC8);
+  box-shadow: 0 2px 3px rgba(0, 0, 0, .25); animation: sw-bob 2.4s ease-in-out infinite; animation-delay: calc(var(--k) * .1s);
+}
+/* A press you can feel, on a phone. */
+.sora-winter__hero:active, .sora-winter__tile:active, .sora-winter__all:active { transform: scale(.96); transition-duration: .08s; }
+/* The heading catches the light every few seconds. */
+.sora-winter__title { position: relative; }
+.sora-winter__title::after {
+  content: ''; position: absolute; inset: -6px -10px; pointer-events: none; mix-blend-mode: soft-light;
+  background: linear-gradient(110deg, transparent 35%, rgba(255, 255, 255, .9) 50%, transparent 65%) no-repeat;
+  background-size: 250% 100%; animation: sw-gleam 5s ease-in-out 1.5s infinite;
+}
+@keyframes sw-gleam { 0%, 60% { background-position: 150% 0; } 100% { background-position: -50% 0; } }
+@media (max-width: 759px) { .sora-winter__orn:nth-child(2), .sora-winter__orn:nth-child(3) { display: none; } }
+@media (prefers-reduced-motion: reduce) { .sora-winter__deco, .sora-winter__hem i { animation: none !important; } .sora-winter__twinkle { display: none; } }
+/* Inside the Fashion store (square corners by design, `.fs *` in fashion.css): the tiles
+   take its corners, but snow and pom-poms stay round and the edit link stays readable. */
+.fs .sora-winter__snow i, .fs .sora-winter__hem i { border-radius: 50% !important; }
+.fs a.sora-winter__all { color: var(--w-ink); }
